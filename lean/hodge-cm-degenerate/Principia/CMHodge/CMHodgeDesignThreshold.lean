/-! ## Part 3. An exact design in `O` at `t = 9` (rational weights, 19 pieces): the 27 rows of `ch ∈ B` hold

Elements of `O = ℤ[θ]` (`θ³ + θ² − 6θ − 7 = 0`) are triples `(c₀, c₁, c₂)`; `mulO` multiplies, `tauO` is the Galois map
`θ ↦ 4 − θ²`.  The test functions are `f_{αβ}(u) = ((t − u)² + 19) τ(u)^α τ²(u)^β` (one slot suffices: an element of `O ⊗ ℚ`
carries all three embeddings).  The dictionary "27 rows ⟺ `ch(G) ∈ B`" is the paper part (491st/495th runs). -/

def mulO (u v : ℚ × ℚ × ℚ) : ℚ × ℚ × ℚ :=
  let r0 := u.1 * v.1
  let r1 := u.1 * v.2.1 + u.2.1 * v.1
  let r2 := u.1 * v.2.2 + u.2.1 * v.2.1 + u.2.2 * v.1
  let r3 := u.2.1 * v.2.2 + u.2.2 * v.2.1
  let r4 := u.2.2 * v.2.2
  (r0 + 7 * r3 - 7 * r4, r1 + 6 * r3 + r4, r2 - r3 + 7 * r4)

def tauO (u : ℚ × ℚ × ℚ) : ℚ × ℚ × ℚ := (u.1 + 4 * u.2.1 + 9 * u.2.2, u.2.2, -u.2.1 - u.2.2)

def gO (u : ℚ × ℚ × ℚ) : ℚ × ℚ × ℚ := let w : ℚ × ℚ × ℚ := ((9 : ℚ) - u.1, -u.2.1, -u.2.2); mulO w w + (19, 0, 0)

def powO (u : ℚ × ℚ × ℚ) : ℕ → ℚ × ℚ × ℚ
  | 0 => (1, 0, 0)
  | n + 1 => mulO (powO u n) u

def fO (a b : ℕ) (u : ℚ × ℚ × ℚ) : ℚ × ℚ × ℚ := mulO (mulO (gO u) (powO (tauO u) a)) (powO (tauO (tauO u)) b)


import Mathlib

/-!
# Design threshold for the full separation of [RM] §12 type, CM analogue (`q = 19`)

Part 1: counting (C2 parity, trace count).  Part 2: an exact real-relaxation design at `t = 7` (no symmetric certificate
on norm `≥ 1`).  Part 3: an exact design in `O` at `t = 9` with rational weights (27 rows).  Hypotheses are in the theorem
names and statements.  The dictionary "27 rows ⟺ `ch(G)` in the secant space" and the Koszul formula are paper parts.
-/

namespace DesignThreshold

open Finset BigOperators

/-- (C2) parity obstruction, hypotheses in the name: twist `t` even, weights natural numbers,
constant coordinates `c0 i` of the products `a_i b_i` integers.  Then `2 · Σ n_i c0_i ≠ t² + 19`. -/
theorem c2_parity_obstruction_of_even_twist {ι : Type*} (s : Finset ι) (n : ι → ℕ) (c0 : ι → ℤ)
    (t : ℤ) (ht : Even t) : (2 : ℤ) * ∑ i ∈ s, (n i : ℤ) * c0 i ≠ t ^ 2 + 19 := by
  intro h
  obtain ⟨k, hk⟩ := ht
  have : (2 : ℤ) * (∑ i ∈ s, (n i : ℤ) * c0 i) = 2 * (2 * k ^ 2 + 9) + 1 := by rw [h, hk]; ring
  omega

/-- Odd twists make (C2) integral: `(t² + 19)/2 ∈ ℤ` for odd `t`. -/
theorem c2_integral_of_odd_twist (t : ℤ) (ht : Odd t) : (2 : ℤ) ∣ t ^ 2 + 19 := by
  obtain ⟨k, hk⟩ := ht
  exact ⟨2 * k ^ 2 + 2 * k + 10, by rw [hk]; ring⟩

/-- Trace count, hypotheses in the name: natural weights, every trace `≥ 3`, total `Σ n_i tr_i = 3 N`.
Then the number of pieces with multiplicity is at most `N`. -/
theorem piece_count_le_of_trace_ge_three {ι : Type*} (s : Finset ι) (n : ι → ℕ) (tr : ι → ℝ) (N : ℝ)
    (htr : ∀ i ∈ s, 3 ≤ tr i) (hsum : ∑ i ∈ s, (n i : ℝ) * tr i = 3 * N) :
    (∑ i ∈ s, (n i : ℝ)) ≤ N := by
  have h1 : ∑ i ∈ s, (n i : ℝ) * 3 ≤ ∑ i ∈ s, (n i : ℝ) * tr i :=
    Finset.sum_le_sum fun i hi => mul_le_mul_of_nonneg_left (htr i hi) (Nat.cast_nonneg _)
  rw [← Finset.sum_mul] at h1
  linarith

/-- AM–GM for the trace of a totally positive element of norm `≥ 1`:
`x, y, z > 0`, `x y z ≥ 1` implies `x + y + z ≥ 3`. -/
theorem trace_ge_three_of_norm_ge_one (x y z : ℝ) (hx : 0 < x) (hy : 0 < y) (hz : 0 < z)
    (hn : 1 ≤ x * y * z) : 3 ≤ x + y + z := by
  nlinarith [sq_nonneg (x - y), sq_nonneg (y - z), sq_nonneg (x - z), mul_pos hx hy, mul_pos hy hz,
    mul_pos hx hz, sq_nonneg (x + y + z - 3), mul_pos (mul_pos hx hy) hz]

/-- The values used in the text: `N_t = (t² + 19)/2` for `t = 3, 5, 7, 9`. -/
theorem c2_values : (3 ^ 2 + 19) / 2 = 14 ∧ (5 ^ 2 + 19) / 2 = 22 ∧ (7 ^ 2 + 19) / 2 = 34 ∧
    (9 ^ 2 + 19) / 2 = 50 := by norm_num


/-! ## Part 2. An exact real-relaxation design at `t = 7` (`q = 19`): no symmetric certificate on norm `≥ 1`

`b1 … b6` span the `S₃`-symmetric part of `T_7` (multidegree `≤ (2,2,2)`, vanishing at `(7 ± i√19)^{×3}`; checked by exact
computation outside Lean).  Six rational pieces with `a₁a₂a₃ ≥ 1`, `b₁b₂b₃ ≥ 1` and non-negative weights reproduce `b_k(0)`. -/

def sb1 (x y z : ℚ) : ℚ := (204 : ℚ) * 1 + (-14 : ℚ) * (x + y + z) + (1 : ℚ) * (x^2 + y^2 + z^2)

def sb2 (x y z : ℚ) : ℚ := (136 : ℚ) * (x + y + z) + (-28 : ℚ) * (x*y + x*z + y*z) + (1 : ℚ) * (x^2*y + x^2*z + y^2*x + y^2*z + z^2*x + z^2*y)

def sb3 (x y z : ℚ) : ℚ := (68 : ℚ) * (x*y + x*z + y*z) + (-42 : ℚ) * (x*y*z) + (1 : ℚ) * (x^2*y*z + y^2*x*z + z^2*x*y)

def sb4 (x y z : ℚ) : ℚ := (-13872 : ℚ) * 1 + (1904 : ℚ) * (x + y + z) + (-196 : ℚ) * (x*y + x*z + y*z) + (1 : ℚ) * (x^2*y^2 + x^2*z^2 + y^2*z^2)

def sb5 (x y z : ℚ) : ℚ := (-4624 : ℚ) * (x + y + z) + (1904 : ℚ) * (x*y + x*z + y*z) + (-588 : ℚ) * (x*y*z) + (1 : ℚ) * (x^2*y^2*z + x^2*z^2*y + y^2*z^2*x)

def sb6 (x y z : ℚ) : ℚ := (314432 : ℚ) * 1 + (-64736 : ℚ) * (x + y + z) + (13328 : ℚ) * (x*y + x*z + y*z) + (-2744 : ℚ) * (x*y*z) + (1 : ℚ) * (x^2*y^2*z^2)

/-- the twist weight `g(x) = (7 − x)² + 19` -/
def gw (x : ℚ) : ℚ := (7 - x)^2 + 19

def sr1 (v w : ℚ) : ℚ := (1 : ℚ) * (v^0 * w^0)

/-- membership: `b_1 = Σ_j g(u_j) R_1(u_k, u_l)` lies in the span of the test functions `g(u_j) u_k^α u_l^β` -/
theorem sb1_mem (x y z : ℚ) : sb1 x y z = gw x * sr1 y z + gw y * sr1 x z + gw z * sr1 x y := by
  simp only [sb1, sr1, gw]; ring

def sr2 (v w : ℚ) : ℚ := (1 : ℚ) * ((v^0 * w^1) + (v^1 * w^0))

/-- membership: `b_2 = Σ_j g(u_j) R_2(u_k, u_l)` lies in the span of the test functions `g(u_j) u_k^α u_l^β` -/
theorem sb2_mem (x y z : ℚ) : sb2 x y z = gw x * sr2 y z + gw y * sr2 x z + gw z * sr2 x y := by
  simp only [sb2, sr2, gw]; ring

def sr3 (v w : ℚ) : ℚ := (1 : ℚ) * (v^1 * w^1)

/-- membership: `b_3 = Σ_j g(u_j) R_3(u_k, u_l)` lies in the span of the test functions `g(u_j) u_k^α u_l^β` -/
theorem sb3_mem (x y z : ℚ) : sb3 x y z = gw x * sr3 y z + gw y * sr3 x z + gw z * sr3 x y := by
  simp only [sb3, sr3, gw]; ring

def sr4 (v w : ℚ) : ℚ := (-68 : ℚ) * (v^0 * w^0) + (7 : ℚ) * ((v^0 * w^1) + (v^1 * w^0)) + ((1 : ℚ) / 2) * ((v^0 * w^2) + (v^2 * w^0))

/-- membership: `b_4 = Σ_j g(u_j) R_4(u_k, u_l)` lies in the span of the test functions `g(u_j) u_k^α u_l^β` -/
theorem sb4_mem (x y z : ℚ) : sb4 x y z = gw x * sr4 y z + gw y * sr4 x z + gw z * sr4 x y := by
  simp only [sb4, sr4, gw]; ring

def sr5 (v w : ℚ) : ℚ := (-34 : ℚ) * ((v^0 * w^1) + (v^1 * w^0)) + (14 : ℚ) * (v^1 * w^1) + ((1 : ℚ) / 2) * ((v^1 * w^2) + (v^2 * w^1))

/-- membership: `b_5 = Σ_j g(u_j) R_5(u_k, u_l)` lies in the span of the test functions `g(u_j) u_k^α u_l^β` -/
theorem sb5_mem (x y z : ℚ) : sb5 x y z = gw x * sr5 y z + gw y * sr5 x z + gw z * sr5 x y := by
  simp only [sb5, sr5, gw]; ring

def sr6 (v w : ℚ) : ℚ := ((4624 : ℚ) / 3) * (v^0 * w^0) + ((-952 : ℚ) / 3) * ((v^0 * w^1) + (v^1 * w^0)) + ((-34 : ℚ) / 3) * ((v^0 * w^2) + (v^2 * w^0)) + ((196 : ℚ) / 3) * (v^1 * w^1) + ((7 : ℚ) / 3) * ((v^1 * w^2) + (v^2 * w^1)) + ((1 : ℚ) / 3) * (v^2 * w^2)

/-- membership: `b_6 = Σ_j g(u_j) R_6(u_k, u_l)` lies in the span of the test functions `g(u_j) u_k^α u_l^β` -/
theorem sb6_mem (x y z : ℚ) : sb6 x y z = gw x * sr6 y z + gw y * sr6 x z + gw z * sr6 x y := by
  simp only [sb6, sr6, gw]; ring

/-- second difference `f(a+b) − f(a) − f(b) + f(0)` -/
def dl (f : ℚ → ℚ → ℚ → ℚ) (a1 a2 a3 b1 b2 b3 : ℚ) : ℚ :=
  f (a1 + b1) (a2 + b2) (a3 + b3) - f a1 a2 a3 - f b1 b2 b3 + f 0 0 0


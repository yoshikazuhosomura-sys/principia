theorem q_zero : q 0 0 0 = 0 := by unfold q; norm_num

/-- a second element of `T_t` with value `1` at the origin. -/
noncomputable def p0 (u1 u2 u3 : ℝ) : ℝ := (1:ℝ) + ((-17774000:ℝ)/293936307)*u3 + ((1000000:ℝ)/293936307)*u3^2 + ((-17774000:ℝ)/293936307)*u2 + ((1000000:ℝ)/293936307)*u2^2 + ((-17774000:ℝ)/293936307)*u1 + ((1000000:ℝ)/293936307)*u1^2


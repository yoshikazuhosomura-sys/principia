noncomputable def q (u1 u2 u3 : ℝ) : ℝ := (8192002451713091:ℝ)*u3 + (-1281317807958:ℝ)*u3^2 + (8192002451713091:ℝ)*u2 + (-2770359199554552:ℝ)*u2*u3 + (-2743451648000:ℝ)*u2*u3^2 + (-1281317807958:ℝ)*u2^2 + (-2743451648000:ℝ)*u2^2*u3 + (-18735513600:ℝ)*u2^2*u3^2 + (8192002451713091:ℝ)*u1 + (-2770359199554552:ℝ)*u1*u3 + (-2743451648000:ℝ)*u1*u3^2 + (-2770359199554552:ℝ)*u1*u2 + (698836965741696:ℝ)*u1*u2*u3 + (3127762944000:ℝ)*u1*u2*u3^2 + (-2743451648000:ℝ)*u1*u2^2 + (3127762944000:ℝ)*u1*u2^2*u3 + (-914553241600:ℝ)*u1*u2^2*u3^2 + (-1281317807958:ℝ)*u1^2 + (-2743451648000:ℝ)*u1^2*u3 + (-18735513600:ℝ)*u1^2*u3^2 + (-2743451648000:ℝ)*u1^2*u2 + (3127762944000:ℝ)*u1^2*u2*u3 + (-914553241600:ℝ)*u1^2*u2*u3^2 + (-18735513600:ℝ)*u1^2*u2^2 + (-914553241600:ℝ)*u1^2*u2^2*u3 + (-172744704:ℝ)*u1^2*u2^2*u3^2

/-- `q ∈ T_t`: `q = Σ_j g(u_j)·h_j`. -/
theorem q_mem (u1 u2 u3 : ℝ) : q u1 u2 u3 =
    g u1 * ((-1281317807958:ℝ) + (-2743451648000:ℝ)*u3 + (-18735513600:ℝ)*u3^2 + (-2743451648000:ℝ)*u2 + (3127762944000:ℝ)*u2*u3 + (-914553241600:ℝ)*u2*u3^2 + (-18735513600:ℝ)*u2^2 + (-914553241600:ℝ)*u2^2*u3 + (-172744704:ℝ)*u2^2*u3^2) + g u2 * ((550371388842:ℝ) + (86668417612800:ℝ)*u3 + (-1847019648:ℝ)*u3^2 + (-3076007014400:ℝ)*u1 + (-13105557094400:ℝ)*u1*u3 + (-917619460096:ℝ)*u1*u3^2) + g u3 * ((730946419116:ℝ) + (86635633014048:ℝ)*u2 + (86635633014048:ℝ)*u1 + (-29393302511104:ℝ)*u1*u2) := by
  unfold q g; ring

theorem q_zero : q 0 0 0 = 0 := by unfold q; norm_num

/-- a second element of `T_t` with value `1` at the origin. -/
noncomputable def p0 (u1 u2 u3 : ℝ) : ℝ := (1:ℝ) + ((-1136:ℝ)/18771)*u3 + ((64:ℝ)/18771)*u3^2 + ((-1136:ℝ)/18771)*u2 + ((64:ℝ)/18771)*u2^2 + ((-1136:ℝ)/18771)*u1 + ((64:ℝ)/18771)*u1^2

theorem p0_mem (u1 u2 u3 : ℝ) : p0 u1 u2 u3 =
    g u1 * (((64:ℝ)/18771)) + g u2 * (((64:ℝ)/18771)) + g u3 * (((64:ℝ)/18771)) := by
  unfold p0 g; ring

theorem p0_zero : p0 0 0 0 = 1 := by unfold p0; norm_num

/-- second difference `Δ_{ab} q = q(a+b) − q(a) − q(b) + q(0)`. -/
noncomputable def dq (a1 a2 a3 b1 b2 b3 : ℝ) : ℝ :=
  q (a1 + b1) (a2 + b2) (a3 + b3) - q a1 a2 a3 - q b1 b2 b3 + q 0 0 0

noncomputable def dp0 (a1 a2 a3 b1 b2 b3 : ℝ) : ℝ :=
  p0 (a1 + b1) (a2 + b2) (a3 + b3) - p0 a1 a2 a3 - p0 b1 b2 b3 + p0 0 0 0


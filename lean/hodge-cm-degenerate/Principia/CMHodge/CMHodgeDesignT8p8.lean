/-- a second element of `T_t` with value `1` at the origin. -/
noncomputable def p0 (u1 u2 u3 : ℝ) : ℝ := (1:ℝ) + ((-5914000:ℝ)/97694641)*u3 + ((1000000:ℝ)/293083923)*u3^2 + ((-5914000:ℝ)/97694641)*u2 + ((1000000:ℝ)/293083923)*u2^2 + ((-5914000:ℝ)/97694641)*u1 + ((1000000:ℝ)/293083923)*u1^2


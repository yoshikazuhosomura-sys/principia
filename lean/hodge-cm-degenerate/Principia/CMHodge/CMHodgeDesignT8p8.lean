noncomputable def q (u1 u2 u3 : ℝ) : ℝ := (803273574971578:ℝ)*u3 + (803273574971578:ℝ)*u2 + (-284961079739707:ℝ)*u2*u3 + (-38780231175:ℝ)*u2*u3^2 + (-38780231175:ℝ)*u2^2*u3 + (803273574971578:ℝ)*u1 + (-284961079739707:ℝ)*u1*u3 + (-38780231175:ℝ)*u1*u3^2 + (-284961079739707:ℝ)*u1*u2 + (75754176454440:ℝ)*u1*u2*u3 + (99479901575:ℝ)*u1*u2*u3^2 + (-38780231175:ℝ)*u1*u2^2 + (99479901575:ℝ)*u1*u2^2*u3 + (-87171482500:ℝ)*u1*u2^2*u3^2 + (-38780231175:ℝ)*u1^2*u3 + (-38780231175:ℝ)*u1^2*u2 + (99479901575:ℝ)*u1^2*u2*u3 + (-87171482500:ℝ)*u1^2*u2*u3^2 + (-87171482500:ℝ)*u1^2*u2^2*u3

/-- `q ∈ T_t`: `q = Σ_j g(u_j)·h_j`. -/
theorem q_mem (u1 u2 u3 : ℝ) : q u1 u2 u3 =
    g u1 * ((-38780231175:ℝ)*u3 + (-38780231175:ℝ)*u2 + (99479901575:ℝ)*u2*u3 + (-87171482500:ℝ)*u2*u3^2 + (-87171482500:ℝ)*u2^2*u3) + g u2 * ((8368037541125:ℝ)*u3 + (-38780231175:ℝ)*u1 + (-1434738190425:ℝ)*u1*u3 + (-87171482500:ℝ)*u1*u3^2) + g u3 * ((8368037541125:ℝ)*u2 + (8368037541125:ℝ)*u1 + (-2968956282425:ℝ)*u1*u2) := by
  unfold q g; ring

theorem q_zero : q 0 0 0 = 0 := by unfold q; norm_num

/-- a second element of `T_t` with value `1` at the origin. -/
noncomputable def p0 (u1 u2 u3 : ℝ) : ℝ := (1:ℝ) + ((-440:ℝ)/7233)*u3 + ((25:ℝ)/7233)*u3^2 + ((-440:ℝ)/7233)*u2 + ((25:ℝ)/7233)*u2^2 + ((-440:ℝ)/7233)*u1 + ((25:ℝ)/7233)*u1^2

theorem p0_mem (u1 u2 u3 : ℝ) : p0 u1 u2 u3 =
    g u1 * (((25:ℝ)/7233)) + g u2 * (((25:ℝ)/7233)) + g u3 * (((25:ℝ)/7233)) := by
  unfold p0 g; ring

theorem p0_zero : p0 0 0 0 = 1 := by unfold p0; norm_num

/-- second difference `Δ_{ab} q = q(a+b) − q(a) − q(b) + q(0)`. -/
noncomputable def dq (a1 a2 a3 b1 b2 b3 : ℝ) : ℝ :=
  q (a1 + b1) (a2 + b2) (a3 + b3) - q a1 a2 a3 - q b1 b2 b3 + q 0 0 0

noncomputable def dp0 (a1 a2 a3 b1 b2 b3 : ℝ) : ℝ :=
  p0 (a1 + b1) (a2 + b2) (a3 + b3) - p0 a1 a2 a3 - p0 b1 b2 b3 + p0 0 0 0


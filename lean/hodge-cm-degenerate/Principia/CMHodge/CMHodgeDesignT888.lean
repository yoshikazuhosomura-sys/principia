/-- `q ∈ T_t`: `q = Σ_j g(u_j)·h_j`. -/
theorem q_mem (u1 u2 u3 : ℝ) : q u1 u2 u3 =
    g u1 * ((-1552461053290762475:ℝ) + (-7929424804687500000:ℝ)*u3 + (-22688176757812500:ℝ)*u3^2 + (-7929424804687500000:ℝ)*u2 + (9991854492187500000:ℝ)*u2*u3 + (-3223277343750000000:ℝ)*u2*u3^2 + (-22688176757812500:ℝ)*u2^2 + (-3223277343750000000:ℝ)*u2^2*u3 + (-209183232421875:ℝ)*u2^2*u3^2) + g u2 * ((667676870438925025:ℝ) + (307482445701562500000:ℝ)*u3 + (-2218677059109375:ℝ)*u3^2 + (-8332366823906250000:ℝ)*u1 + (-47253551132812500000:ℝ)*u1*u3 + (-3226992437957812500:ℝ)*u1*u3^2) + g u3 * ((884784182851837450:ℝ) + (307443041996992717500:ℝ)*u2 + (307443041996992717500:ℝ)*u1 + (-104564936830943250000:ℝ)*u1*u2) := by
  unfold q g; ring

theorem q_zero : q 0 0 0 = 0 := by unfold q; norm_num

/-- a second element of `T_t` with value `1` at the origin. -/
noncomputable def p0 (u1 u2 u3 : ℝ) : ℝ := (1:ℝ) + ((-3700:ℝ)/61159)*u3 + ((625:ℝ)/183477)*u3^2 + ((-3700:ℝ)/61159)*u2 + ((625:ℝ)/183477)*u2^2 + ((-3700:ℝ)/61159)*u1 + ((625:ℝ)/183477)*u1^2

theorem p0_mem (u1 u2 u3 : ℝ) : p0 u1 u2 u3 =
    g u1 * (((625:ℝ)/183477)) + g u2 * (((625:ℝ)/183477)) + g u3 * (((625:ℝ)/183477)) := by
  unfold p0 g; ring

theorem p0_zero : p0 0 0 0 = 1 := by unfold p0; norm_num

/-- second difference `Δ_{ab} q = q(a+b) − q(a) − q(b) + q(0)`. -/
noncomputable def dq (a1 a2 a3 b1 b2 b3 : ℝ) : ℝ :=
  q (a1 + b1) (a2 + b2) (a3 + b3) - q a1 a2 a3 - q b1 b2 b3 + q 0 0 0

noncomputable def dp0 (a1 a2 a3 b1 b2 b3 : ℝ) : ℝ :=
  p0 (a1 + b1) (a2 + b2) (a3 + b3) - p0 a1 a2 a3 - p0 b1 b2 b3 + p0 0 0 0


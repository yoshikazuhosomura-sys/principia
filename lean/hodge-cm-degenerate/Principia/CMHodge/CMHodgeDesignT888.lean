theorem q_mem (u1 u2 u3 : ℝ) : q u1 u2 u3 =
    g u1 * ((-1767414608672823193850:ℝ) + (-21302936000000000000000:ℝ)*u3 + (-25816528000000000000:ℝ)*u3^2 + (-21302936000000000000000:ℝ)*u2 + (27210648000000000000000:ℝ)*u2*u3 + (-8776392000000000000000:ℝ)*u2*u3^2 + (-25816528000000000000:ℝ)*u2^2 + (-8776392000000000000000:ℝ)*u2^2*u3 + (-238032720000000000:ℝ)*u2^2*u3^2) + g u2 * ((761139401949976806150:ℝ) + (838285200344200000000000:ℝ)*u3 + (-2502835747678000000:ℝ)*u3^2 + (-21761695702560000000000:ℝ)*u1 + (-128745837840000000000000:ℝ)*u1*u3 + (-8780621841434400000000:ℝ)*u1*u3^2) + g u3 * ((1006275206722846387700:ℝ) + (838240724952963761940000:ℝ)*u2 + (838240724952963761940000:ℝ)*u1 + (-284777487962289288000000:ℝ)*u1*u2) := by

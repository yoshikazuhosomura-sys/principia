theorem q_zero : q 0 0 0 = 0 := by unfold q; norm_num

/-- a second element of `T_t` with value `1` at the origin. -/
noncomputable def p0 (u1 u2 u3 : ℝ) : ℝ := (1:ℝ) + ((-710800:ℝ)/11753187)*u3 + ((40000:ℝ)/11753187)*u3^2 + ((-710800:ℝ)/11753187)*u2 + ((40000:ℝ)/11753187)*u2^2 + ((-710800:ℝ)/11753187)*u1 + ((40000:ℝ)/11753187)*u1^2

theorem p0_mem (u1 u2 u3 : ℝ) : p0 u1 u2 u3 =
    g u1 * (((40000:ℝ)/11753187)) + g u2 * (((40000:ℝ)/11753187)) + g u3 * (((40000:ℝ)/11753187)) := by
  unfold p0 g; ring

theorem p0_zero : p0 0 0 0 = 1 := by unfold p0; norm_num

/-- second difference `Δ_{ab} q = q(a+b) − q(a) − q(b) + q(0)`. -/
noncomputable def dq (a1 a2 a3 b1 b2 b3 : ℝ) : ℝ :=
  q (a1 + b1) (a2 + b2) (a3 + b3) - q a1 a2 a3 - q b1 b2 b3 + q 0 0 0

noncomputable def dp0 (a1 a2 a3 b1 b2 b3 : ℝ) : ℝ :=
  p0 (a1 + b1) (a2 + b2) (a3 + b3) - p0 a1 a2 a3 - p0 b1 b2 b3 + p0 0 0 0

/-- Lemma O2, first slot: after `a₁ = d + 80`, `−Δq` = 100 squares `c·M·(Σ vᵢ zᵢ)²` (`c > 0`, `M` a monomial, at most four
terms `zᵢ` in each square) + a polynomial with nonnegative coefficients (the coefficient of `b₂` is positive).
No norm condition is used. -/

  · rw [dqc_perm12]; exact dqc_neg_of_a1_ge _ _ _ _ _ _ _ _ _ _ _ l1 u1 l2 u2 l3 u3 l4 u4 l5 u5 hr h p1 p3 p5 p4 p6
  · rw [dqc_perm13]; exact dqc_neg_of_a1_ge _ _ _ _ _ _ _ _ _ _ _ l1 u1 l2 u2 l3 u3 l4 u4 l5 u5 hr h p2 p1 p6 p5 p4
  · rw [dqc_swap]; exact dqc_neg_of_a1_ge _ _ _ _ _ _ _ _ _ _ _ l1 u1 l2 u2 l3 u3 l4 u4 l5 u5 hr h p5 p6 p1 p2 p3
  · rw [dqc_swap, dqc_perm12]; exact dqc_neg_of_a1_ge _ _ _ _ _ _ _ _ _ _ _ l1 u1 l2 u2 l3 u3 l4 u4 l5 u5 hr h p4 p6 p2 p1 p3
  · rw [dqc_swap, dqc_perm13]; exact dqc_neg_of_a1_ge _ _ _ _ _ _ _ _ _ _ _ l1 u1 l2 u2 l3 u3 l4 u4 l5 u5 hr h p5 p4 p3 p2 p1

/-- `g(x) = (x − t)² + 19`; the eight points `(t ± i√19)³` are the common zeros of `g(u₁), g(u₂), g(u₃)`. -/
noncomputable def g (t x : ℝ) : ℝ := (x - t)^2 + 19

/-- (assumption `f t = 0`) `q*_t ∈ T_t`. -/
theorem qs_mem (t : ℝ) (hf : f t = 0) (u1 u2 u3 : ℝ) :
    qs t u1 u2 u3 = g t u1 * (160888*t^3*u2*u3/736635 - 148922988396*t^3*u2/60292347025 - 148922988396*t^3*u3/60292347025 - 3566498*t^2*u2*u3/736635 + 3361554966166*t^2*u2/60292347025 + 3361554966166*t^2*u3/60292347025 + 39084566*t*u2*u3/1718815 - 116243309663836*t*u2/422046429175 - 116243309663836*t*u3/422046429175 - u2^2*u3 - u2*u3^2 + 51770744*u2*u3/1718815 - 13542977013382*u2/60292347025 - 13542977013382*u3/60292347025) + g t u2 * (160888*t^3*u1*u3/736635 - 148922988396*t^3*u1/60292347025 - 148922988396*t^3*u3/60292347025 - 3566498*t^2*u1*u3/736635 + 3361554966166*t^2*u1/60292347025 + 3421847313191*t^2*u3/60292347025 + 35646936*t*u1*u3/1718815 - 116243309663836*t*u1/422046429175 - 116243309663836*t*u3/422046429175 - u1*u3^2 + 51770744*u1*u3/1718815 - 13542977013382*u1/60292347025 - 12397422419907*u3/60292347025) + g t u3 * (160888*t^3*u1*u2/736635 - 148922988396*t^3*u1/60292347025 - 148922988396*t^3*u2/60292347025 - 3566498*t^2*u1*u2/736635 + 3421847313191*t^2*u1/60292347025 + 3421847313191*t^2*u2/60292347025 + 32209306*t*u1*u2/1718815 - 116243309663836*t*u1/422046429175 - 116243309663836*t*u2/422046429175 + 51770744*u1*u2/1718815 - 12397422419907*u1/60292347025 - 12397422419907*u2/60292347025) := by
  unfold f at hf; unfold qs qc g k1 k2 k3 k4 k5
  linear_combination (-8*t*u1*u2/5156445 - 8*t*u1*u3/5156445 + 192531336*t*u1/5486603579275 - 8*t*u2*u3/5156445 + 192531336*t*u2/5486603579275 + 192531336*t*u3/5486603579275 + 16*u1*u2*u3/1718815 - 188949958*u1*u2/2351401533975 - 188949958*u1*u3/2351401533975 + 1772305229811*u1/8487775737138425 - 188949958*u2*u3/2351401533975 + 1772305229811*u2/8487775737138425 + 1772305229811*u3/8487775737138425) * hf

/-- the `C₃`-invariant, `S₃`-alternating `V = (u₁ − u₂)(u₂ − u₃)(u₃ − u₁)`. -/
noncomputable def V (u1 u2 u3 : ℝ) : ℝ := (u1 - u2) * (u2 - u3) * (u3 - u1)
theorem V_mem (t u1 u2 u3 : ℝ) : V u1 u2 u3 = g t u1 * (-u2 + u3) + g t u2 * (u1 - u3) + g t u3 * (-u1 + u2) := by
  unfold V g; ring

noncomputable def p0 (t u1 u2 u3 : ℝ) : ℝ := (g t u1 + g t u2 + g t u3) / (3 * (t^2 + 19))
theorem p0_mem (t u1 u2 u3 : ℝ) :
    p0 t u1 u2 u3 = g t u1 * (1 / (3 * (t^2 + 19))) + g t u2 * (1 / (3 * (t^2 + 19))) + g t u3 * (1 / (3 * (t^2 + 19))) := by
  unfold p0; ring
theorem p0_zero (t : ℝ) : p0 t 0 0 0 = 1 := by
  unfold p0 g
  have : (3 * (t^2 + 19) : ℝ) ≠ 0 := by positivity
  field_simp; ring
theorem qs_zero (t : ℝ) : qs t 0 0 0 = 0 := by unfold qs qc; ring
theorem V_zero : V 0 0 0 = 0 := by unfold V; ring

noncomputable def dV (a1 a2 a3 b1 b2 b3 : ℝ) : ℝ := V (a1 + b1) (a2 + b2) (a3 + b3) - V a1 a2 a3 - V b1 b2 b3 + V 0 0 0
noncomputable def dp0 (t a1 a2 a3 b1 b2 b3 : ℝ) : ℝ :=
  p0 t (a1 + b1) (a2 + b2) (a3 + b3) - p0 t a1 a2 a3 - p0 t b1 b2 b3 + p0 t 0 0 0

/-- **Farkas closure at the root** (assumptions: `f t = 0`, `t` in the bracket; the finite box table `hbox` — every
piece with all six coordinates `≤ 80` has `Δq* < 0`, or `Δq* = 0` and `ΔV < 0` (the family `P₂`), checked outside
Lean —; positive coordinates; nonnegative weights; the design equations for `q*, V, p₀ ∈ T_t`): there is no design.
`q*(0) = 0` forces every weight off the zero set of `Δq*` to vanish, `V(0) = 0` then kills the zero set (`ΔV < 0`
there), and the `p₀`-equation reads `0 = 1`. -/
theorem no_design_at_root (t : ℝ) (hf : f t = 0) (ht₁ : ((1111076101466059765414681793680712635923:ℝ)/125000000000000000000000000000000000000) ≤ t) (ht₂ : t ≤ ((88886088117284781233174543494457010873841:ℝ)/10000000000000000000000000000000000000000))
    {ι : Type*} (s : Finset ι) (a1 a2 a3 b1 b2 b3 n : ι → ℝ)
    (hpos : ∀ i ∈ s, 0 < a1 i ∧ 0 < a2 i ∧ 0 < a3 i ∧ 0 < b1 i ∧ 0 < b2 i ∧ 0 < b3 i)
    (hn : ∀ i ∈ s, 0 ≤ n i)
    (hbox : ∀ i ∈ s, a1 i ≤ 80 → a2 i ≤ 80 → a3 i ≤ 80 → b1 i ≤ 80 → b2 i ≤ 80 → b3 i ≤ 80 →
      dqs t (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) < 0 ∨
      (dqs t (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) = 0 ∧ dV (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) < 0))
    (hq : ∑ i ∈ s, n i * dqs t (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) = qs t 0 0 0)
    (hV : ∑ i ∈ s, n i * dV (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) = V 0 0 0)
    (hp : ∑ i ∈ s, n i * dp0 t (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) = p0 t 0 0 0) : False := by
  have hcase : ∀ i ∈ s, dqs t (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) < 0 ∨
      (dqs t (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) = 0 ∧ dV (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) < 0) := by
    intro i hi
    obtain ⟨p1, p2, p3, p4, p5, p6⟩ := hpos i hi
    by_cases hall : a1 i ≤ 80 ∧ a2 i ≤ 80 ∧ a3 i ≤ 80 ∧ b1 i ≤ 80 ∧ b2 i ≤ 80 ∧ b3 i ≤ 80
    · obtain ⟨c1, c2, c3, c4, c5, c6⟩ := hall; exact hbox i hi c1 c2 c3 c4 c5 c6
    · left
      apply dqs_neg_of_some_coord_ge t hf ht₁ ht₂ _ _ _ _ _ _ p1 p2 p3 p4 p5 p6
      by_contra hc; simp only [not_or, not_le] at hc
      exact hall ⟨hc.1.le, hc.2.1.le, hc.2.2.1.le, hc.2.2.2.1.le, hc.2.2.2.2.1.le, hc.2.2.2.2.2.le⟩
  have hterm : ∀ i ∈ s, n i * dqs t (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) ≤ 0 := by
    intro i hi
    rcases hcase i hi with h | h
    · exact mul_nonpos_of_nonneg_of_nonpos (hn i hi) h.le
    · rw [h.1, mul_zero]
  rw [qs_zero] at hq
  have hz := (Finset.sum_eq_zero_iff_of_nonpos hterm).1 hq
  have hVterm : ∀ i ∈ s, n i * dV (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) ≤ 0 := by
    intro i hi
    rcases hcase i hi with h | h
    · have : n i = 0 := by
        rcases mul_eq_zero.1 (hz i hi) with h' | h'
        · exact h'
        · exact absurd h' h.ne
      rw [this, zero_mul]
    · exact mul_nonpos_of_nonneg_of_nonpos (hn i hi) h.2.le
  rw [V_zero] at hV
  have hzV := (Finset.sum_eq_zero_iff_of_nonpos hVterm).1 hV
  have hn0 : ∀ i ∈ s, n i = 0 := by
    intro i hi
    rcases hcase i hi with h | h
    · rcases mul_eq_zero.1 (hz i hi) with h' | h'
      · exact h'
      · exact absurd h' h.ne
    · rcases mul_eq_zero.1 (hzV i hi) with h' | h'
      · exact h'
      · exact absurd h' h.2.ne
  have : ∑ i ∈ s, n i * dp0 t (a1 i) (a2 i) (a3 i) (b1 i) (b2 i) (b3 i) = 0 :=
    Finset.sum_eq_zero (fun i hi => by rw [hn0 i hi, zero_mul])
  rw [this, p0_zero] at hp; norm_num at hp


/-- enclosure of a cubic on `[0, w]` -/
theorem cubic_enclose (p0 p1 p2 p3 B1 B2 B3 s w : ℝ) (hs : 0 ≤ s) (hsw : s ≤ w)
    (h1 : -B1 ≤ p1 ∧ p1 ≤ B1) (h2 : -B2 ≤ p2 ∧ p2 ≤ B2) (h3 : -B3 ≤ p3 ∧ p3 ≤ B3) :
    p0 - (B1*w + B2*w^2 + B3*w^3) ≤ p0 + p1*s + p2*s^2 + p3*s^3 ∧
    p0 + p1*s + p2*s^2 + p3*s^3 ≤ p0 + (B1*w + B2*w^2 + B3*w^3) := by
  have hw : 0 ≤ w := le_trans hs hsw
  have s2 : s^2 ≤ w^2 := by nlinarith
  have s3 : s^3 ≤ w^3 := by nlinarith [mul_nonneg hs hs]
  have s2n : 0 ≤ s^2 := by positivity
  have s3n : 0 ≤ s^3 := by positivity
  have b1 : 0 ≤ B1 := by linarith [h1.1, h1.2]
  have b2 : 0 ≤ B2 := by linarith [h2.1, h2.2]
  have b3 : 0 ≤ B3 := by linarith [h3.1, h3.2]
  have x1 := mul_nonneg (by linarith [h1.1] : 0 ≤ p1 + B1) hs
  have y1 := mul_nonneg (by linarith [h1.2] : 0 ≤ B1 - p1) hs
  have z1 := mul_nonneg b1 (by linarith : 0 ≤ w - s)
  have x2 := mul_nonneg (by linarith [h2.1] : 0 ≤ p2 + B2) s2n
  have y2 := mul_nonneg (by linarith [h2.2] : 0 ≤ B2 - p2) s2n
  have z2 := mul_nonneg b2 (by linarith : 0 ≤ w^2 - s^2)
  have x3 := mul_nonneg (by linarith [h3.1] : 0 ≤ p3 + B3) s3n
  have y3 := mul_nonneg (by linarith [h3.2] : 0 ≤ B3 - p3) s3n
  have z3 := mul_nonneg b3 (by linarith : 0 ≤ w^3 - s^3)
  constructor <;> nlinarith


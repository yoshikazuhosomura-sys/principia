/-
  `O`-version of the §12-type totally separated design, q = 19, rational twist `t` (all three embeddings equal `t`),
  the 27 rows of degrees 4..12.  `O = Z[θ]`, θ³ + θ² − 6θ − 7 = 0.

  PART 1 (namespace `DesignT35Quarter`): what a Lemma-O type certificate (one-term domination outside the box) can do.
    Notation: an `S₃`-symmetric polynomial of multidegree ≤ (2,2,2) in the embeddings `u₁,u₂,u₃` is
      q = c0 + c1·m100 + c2·m110 + c3·m111 + c4·m200 + c5·m210 + c6·m211 + c7·m220 + c8·m221 + c9·m222
    (`m_o` = sum of the distinct monomials of the `S₃`-orbit of `o`).
    * `member{k}_t…_eq` / `_rows`: six members `Σ_j g(u_j)·h_k(u_k,u_l)` of `T_t` (`g(x) = (x−t)²+19`), and the four
      rational rows `hT1..hT4` used below vanish on them (the six are independent, so the rows cut out their span).
    * `lemmaO_radius_ge_of_P1_t35over4` (hypotheses: the four `T_{35/4}` rows, `c211 = −1`, `c200, c210, c220, c222 ≤ 0`,
      `c0 ≥ 0`, `Δ_{P₁} q ≤ 0`): `c111 ≥ 31874115/25468 ≈ 1251.5`.  `…_span_…`: the same with `q` in the span of the
      six members (no row hypotheses).  `line_point_attains_…`: the bound is attained (the earlier line at `s*`).
      `P₁ = (−2−θ+θ², 18+3θ−2θ²)`; `Δ_{P₁} m_o` from characteristic polynomials in `Z[θ]` (`charpoly_*`, `dP1_vals`).
    * `lemmaO_empty_of_P1_t44over5 / t71over8 / t9` (same hypotheses plus `c110, c221 ≤ 0`): `False`.
  PART 2 (namespaces `DesignT35QuarterCert`, `DesignT703over80Cert`, `DesignT879over100Cert`, `DesignT1759over200Cert`):
    the earlier line certificate `q = q_t + s·w_t` with `q(0) = 0`, and
    * `dq_neg_shift` = Lemma O2: after `a₁ = d + R` (R = 82 for t = 35/4, R = 100 for the other three), `−Δq` is an
      explicit sum of two-term AM–GM squares `c·M·(r·u − v)²` plus a polynomial with nonnegative coefficients (`ring` +
      `positivity`); `dq_neg_of_some_coord_ge` (six coordinates > 0, one of them ≥ R): `Δq < 0`.  No norm condition.
    * `no_design_of_box_table` (ASSUMPTION `hbox`: every piece with all six coordinates ≤ R has `Δq < 0`; positive
      coordinates, nonnegative weights, the design equations for `q` and `p0`): `False`.
      The table `hbox` was checked exactly outside Lean for the totally positive elements of `O` with all embeddings
      ≤ R (box B_82: 29,020 elements, all 421,094,710 unordered pairs; box B_100: 52,630 elements, 463,410,139 pairs up
      to the simultaneous Galois action, and all 1,384,984,765 unordered pairs for t = 1759/200), integer arithmetic on
      characteristic polynomials (`__int128`).  Lean does not see `O`.
  The dictionary "design ⟺ `Σ n Δp = p(0)` for all `p ∈ T_t`" (earlier notes, on paper) is not formalised here.
-/
import Mathlib

set_option linter.unusedVariables false
set_option maxHeartbeats 4000000

namespace DesignT35Quarter

/-- characteristic-polynomial coefficients `(e1, e2, e3)` of multiplication by `x0 + x1 θ + x2 θ²` on `Z[θ]`,
`θ³ = −θ² + 6θ + 7`, basis `(1, θ, θ²)`.  Matrix of `θ`: columns `θ·1 = θ`, `θ·θ = θ²`, `θ·θ² = 7 + 6θ − θ²`. -/
def mulMat (x0 x1 x2 : ℤ) : Matrix (Fin 3) (Fin 3) ℤ :=
  let T : Matrix (Fin 3) (Fin 3) ℤ := !![0, 0, 7; 1, 0, 6; 0, 1, -1]
  x0 • (1 : Matrix (Fin 3) (Fin 3) ℤ) + x1 • T + x2 • (T * T)

def e1 (M : Matrix (Fin 3) (Fin 3) ℤ) : ℤ := M 0 0 + M 1 1 + M 2 2
def e2 (M : Matrix (Fin 3) (Fin 3) ℤ) : ℤ :=
  (M 0 0 * M 1 1 - M 0 1 * M 1 0) + (M 0 0 * M 2 2 - M 0 2 * M 2 0) + (M 1 1 * M 2 2 - M 1 2 * M 2 1)
def e3 (M : Matrix (Fin 3) (Fin 3) ℤ) : ℤ :=
  M 0 0 * (M 1 1 * M 2 2 - M 1 2 * M 2 1) - M 0 1 * (M 1 0 * M 2 2 - M 1 2 * M 2 0)
    + M 0 2 * (M 1 0 * M 2 1 - M 1 1 * M 2 0)

/-- the ten orbit sums written through `(e1, e2, e3)` (Newton's identities for three variables) -/
def orbs (a b c : ℤ) : List ℤ :=
  [1, a, b, c, a * a - 2 * b, a * b - 3 * c, a * c, b * b - 2 * a * c, b * c, c * c]

def E (x0 x1 x2 : ℤ) : ℤ × ℤ × ℤ :=
  let M := mulMat x0 x1 x2; (e1 M, e2 M, e3 M)

theorem charpoly_a : E (-2) (-1) 1 = (8, 15, 7) := by decide
theorem charpoly_b : E 18 3 (-2) = (25, 164, 103) := by decide
theorem charpoly_ab : E 16 2 (-1) = (33, 344, 1103) := by decide

/-- `Δ_{P₁} m_o = m_o(a+b) − m_o(a) − m_o(b) + m_o(0)` for `o ≠ 0` (the entry for `o = 0` is `0`) -/
theorem dP1_vals :
    List.zipWith (· - ·) (List.zipWith (· - ·) (orbs 33 344 1103) (orbs 8 15 7)) (orbs 25 164 103)
      = [-1, 0, 165, 993, 70, 4153, 33768, 23679, 362435, 1205951] := by decide



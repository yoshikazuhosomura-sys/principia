/-
  ハドヴィガー・ネルソン（Erdős #132 系）：`n = 11`・独立数 `α ≤ 3` の候補 117 類は
  いずれも平面に単位距離で実現しない（`f(3) ≤ 10` の証明書部分）。

  実現の非存在は、辺の長さ 1 の等式から座標の区間を絞る**三辺測量の証明書**で閉じる。
  区間演算を有理数の閉区間で Lean の中に実装し、各候補の証明書を `decide` で検査する。
  自由角の残る 4 類（38・63・65・115）は、角の箱を二分して同じ検査を繰り返す。

  列挙の完全性（候補が 117 類で尽きること）は Lean の外に置いてある。
  Lean が言うのは「この辺集合をもつ 11 点の平面配置は存在しない」までである。

  sorry 0・native_decide 不使用。
-/
import Mathlib

/-!
##   ハドヴィガー・ネルソン（#132 系）：`n = 11`・`α ≤ 3` の候補 117 類が
  平面に単位距離で実現しないことを Lean 4 で閉じる。**一般部**（本ファイル）。

  Python の 160 ビット固定小数点区間演算で出した結論
  「候補 117 類のうち 113 類は素の三辺測量＋区間演算で棄却」を、
  Lean の中で「証明書の検査」に落とす。

  設計（`√` を式から消すのが要点）：

  * 頂点 `v` が既に置いた `a, b` の双方から単位距離にあるとき、
    `u := v − (a+b)/2`、`d := b − a` と置けば
        `u ⊥ d`  かつ  `|u|² = 1 − |d|²/4`
    である。`d ≠ 0` なら `u = lam · (−d_y, d_x)` と書けて（`trilat_core`）、
        `|d|² · (4 lam² + 1) = 4`
    が成り立つ。**`lam` の有理上下界は、平方根を取らずに整数の不等式だけで検査できる**
    （`lam_box`）。証明書は各分枝でその上下界 `(ll, lu)` を差し出し、Lean は掛け算で検める。
  * 区間は尺度 `sc = 2^40` の固定小数点（端点は `ℤ`）。`Sem I x ↔ I.lo ≤ sc·x ≤ I.hi`。
    加減は厳密、乗算だけが外側への丸めを起こす（`mulI`）。
    Python 側（`erdos1178gen.py`）は**逐語で同じ**演算をする。

  sorry 0・native_decide 不使用・`nlinarith`/`polyrith` 不使用。
-/

namespace UnitDistance.Order11

/-! ## 1. 尺度と区間 -/

/-- 固定小数点の尺度 `2^40`。リテラルで書くのは核の評価を速くするため。 -/
def sc : ℤ := 1099511627776

/-- `sc / 2`。 -/
def shalf : ℤ := 549755813888

lemma sc_pos : (0:ℤ) < sc := by norm_num [sc]

lemma scR_pos : (0:ℝ) < (sc:ℝ) := by norm_num [sc]

lemma sc_ne : (sc:ℤ) ≠ 0 := by norm_num [sc]

/-- 端点が `ℤ`（尺度 `sc`）の閉区間。 -/
structure Ivl where
  lo : ℤ
  hi : ℤ
deriving DecidableEq

/-- `x` が区間 `I` に入る：`I.lo ≤ sc·x ≤ I.hi`。 -/
def Sem (I : Ivl) (x : ℝ) : Prop := (I.lo : ℝ) ≤ (sc:ℝ) * x ∧ (sc:ℝ) * x ≤ (I.hi : ℝ)

def addI (a b : Ivl) : Ivl := ⟨a.lo + b.lo, a.hi + b.hi⟩

def subI (a b : Ivl) : Ivl := ⟨a.lo - b.hi, a.hi - b.lo⟩

def mulI (a b : Ivl) : Ivl :=
  ⟨(min (min (a.lo*b.lo) (a.lo*b.hi)) (min (a.hi*b.lo) (a.hi*b.hi))) / sc,
   -((-(max (max (a.lo*b.lo) (a.lo*b.hi)) (max (a.hi*b.lo) (a.hi*b.hi)))) / sc)⟩

/-! ## 2. 区間演算の健全性 -/

lemma addI_sound {a b : Ivl} {x y : ℝ} (ha : Sem a x) (hb : Sem b y) : Sem (addI a b) (x + y) := by
  obtain ⟨h1, h2⟩ := ha; obtain ⟨h3, h4⟩ := hb
  refine ⟨?_, ?_⟩ <;> simp only [addI] <;> push_cast <;> linarith

lemma subI_sound {a b : Ivl} {x y : ℝ} (ha : Sem a x) (hb : Sem b y) : Sem (subI a b) (x - y) := by
  obtain ⟨h1, h2⟩ := ha; obtain ⟨h3, h4⟩ := hb
  refine ⟨?_, ?_⟩ <;> simp only [subI] <;> push_cast <;> linarith

/-- 床：`sc > 0` なので `sc * (p / sc) ≤ p`。 -/
lemma mul_ediv_le (p : ℤ) : sc * (p / sc) ≤ p := by
  unfold sc
  omega

lemma cast_floor_le (p : ℤ) : ((p / sc : ℤ) : ℝ) * (sc:ℝ) ≤ (p:ℝ) := by
  have h := mul_ediv_le p
  have h' : ((sc * (p / sc) : ℤ) : ℝ) ≤ ((p:ℤ):ℝ) := by exact_mod_cast h
  push_cast at h'
  linarith

lemma cast_le_ceil (p : ℤ) : (p:ℝ) ≤ ((-((-p) / sc) : ℤ) : ℝ) * (sc:ℝ) := by
  have h := mul_ediv_le (-p)
  have h' : ((sc * ((-p) / sc) : ℤ) : ℝ) ≤ (((-p):ℤ):ℝ) := by exact_mod_cast h
  push_cast at h'
  push_cast
  linarith

lemma mul_le_maxL {al ah u v : ℝ} (h1 : al ≤ u) (h2 : u ≤ ah) : u * v ≤ max (al*v) (ah*v) := by
  rcases le_or_gt 0 v with hv | hv
  · exact le_max_of_le_right (mul_le_mul_of_nonneg_right h2 hv)
  · exact le_max_of_le_left (mul_le_mul_of_nonpos_right h1 hv.le)

lemma minL_le_mul {al ah u v : ℝ} (h1 : al ≤ u) (h2 : u ≤ ah) : min (al*v) (ah*v) ≤ u * v := by
  rcases le_or_gt 0 v with hv | hv
  · exact le_trans (min_le_left _ _) (mul_le_mul_of_nonneg_right h1 hv)
  · exact le_trans (min_le_right _ _) (mul_le_mul_of_nonpos_right h2 hv.le)

lemma mul_le_maxR {bl bh v : ℝ} (a : ℝ) (h1 : bl ≤ v) (h2 : v ≤ bh) :
    a * v ≤ max (a*bl) (a*bh) := by
  rcases le_or_gt 0 a with ha | ha
  · exact le_max_of_le_right (mul_le_mul_of_nonneg_left h2 ha)
  · exact le_max_of_le_left (mul_le_mul_of_nonpos_left h1 ha.le)

lemma minR_le_mul {bl bh v : ℝ} (a : ℝ) (h1 : bl ≤ v) (h2 : v ≤ bh) :
    min (a*bl) (a*bh) ≤ a * v := by
  rcases le_or_gt 0 a with ha | ha
  · exact le_trans (min_le_left _ _) (mul_le_mul_of_nonneg_left h1 ha)
  · exact le_trans (min_le_right _ _) (mul_le_mul_of_nonpos_left h2 ha.le)

/-- 積の 4 点上下界（実数）。 -/
lemma prod_bounds {al ah bl bh u v : ℝ} (h1 : al ≤ u) (h2 : u ≤ ah) (h3 : bl ≤ v) (h4 : v ≤ bh) :
    min (min (al*bl) (al*bh)) (min (ah*bl) (ah*bh)) ≤ u*v ∧
      u*v ≤ max (max (al*bl) (al*bh)) (max (ah*bl) (ah*bh)) := by
  refine ⟨?_, ?_⟩
  · exact le_trans (min_le_min (minR_le_mul al h3 h4) (minR_le_mul ah h3 h4)) (minL_le_mul h1 h2)
  · exact le_trans (mul_le_maxL h1 h2)
      (max_le_max (mul_le_maxR al h3 h4) (mul_le_maxR ah h3 h4))

lemma mulI_sound {a b : Ivl} {x y : ℝ} (ha : Sem a x) (hb : Sem b y) : Sem (mulI a b) (x * y) := by
  obtain ⟨h1, h2⟩ := ha; obtain ⟨h3, h4⟩ := hb
  obtain ⟨hmin, hmax⟩ := prod_bounds h1 h2 h3 h4
  refine ⟨?_, ?_⟩
  · simp only [mulI]
    have hf := cast_floor_le (min (min (a.lo*b.lo) (a.lo*b.hi)) (min (a.hi*b.lo) (a.hi*b.hi)))
    have hPc : ((min (min (a.lo*b.lo) (a.lo*b.hi)) (min (a.hi*b.lo) (a.hi*b.hi)) : ℤ):ℝ)
        ≤ ((sc:ℝ)*x) * ((sc:ℝ)*y) := by push_cast; exact hmin
    have h5 : ((min (min (a.lo*b.lo) (a.lo*b.hi)) (min (a.hi*b.lo) (a.hi*b.hi)) / sc : ℤ):ℝ)
          * (sc:ℝ) ≤ ((sc:ℝ) * (x*y)) * (sc:ℝ) := by
      refine le_trans (le_trans hf hPc) ?_
      apply le_of_eq; ring
    exact le_of_mul_le_mul_right h5 scR_pos
  · simp only [mulI]
    have hf := cast_le_ceil (max (max (a.lo*b.lo) (a.lo*b.hi)) (max (a.hi*b.lo) (a.hi*b.hi)))
    have hQc : ((sc:ℝ)*x) * ((sc:ℝ)*y)
        ≤ ((max (max (a.lo*b.lo) (a.lo*b.hi)) (max (a.hi*b.lo) (a.hi*b.hi)) : ℤ):ℝ) := by
      push_cast; exact hmax
    have h5 : ((sc:ℝ) * (x*y)) * (sc:ℝ)
        ≤ ((-((-(max (max (a.lo*b.lo) (a.lo*b.hi)) (max (a.hi*b.lo) (a.hi*b.hi)))) / sc) : ℤ):ℝ)
          * (sc:ℝ) := by
      refine le_trans (le_of_eq ?_) (le_trans hQc hf)
      ring
    exact le_of_mul_le_mul_right h5 scR_pos

lemma half_sound : Sem ⟨shalf, shalf⟩ (1/2 : ℝ) := by
  refine ⟨?_, ?_⟩ <;> norm_num [Sem, sc, shalf]

/-! ## 3. 三辺測量（核） -/

/-- **`trilat_core`**：`u ⊥ d`・`d ≠ 0` なら `u` は `d` の直交方向 `(−d_y, d_x)` の実数倍。 -/
lemma trilat_core {ux uy dx dy : ℝ} (hD : dx^2 + dy^2 ≠ 0) (hlin : ux*dx + uy*dy = 0) :
    ∃ lam : ℝ, ux = -(lam*dy) ∧ uy = lam*dx := by
  refine ⟨(uy*dx - ux*dy)/(dx^2+dy^2), ?_, ?_⟩
  · rw [show -((uy*dx - ux*dy)/(dx^2+dy^2)*dy) = (-((uy*dx - ux*dy)*dy))/(dx^2+dy^2) from by
      ring, eq_div_iff hD]
    linear_combination dx * hlin
  · rw [show (uy*dx - ux*dy)/(dx^2+dy^2)*dx = ((uy*dx - ux*dy)*dx)/(dx^2+dy^2) from by
      ring, eq_div_iff hD]
    linear_combination dy * hlin

lemma abs_le_of_sq {t c : ℝ} (hc : 0 ≤ c) (h : t*t ≤ c*c) : |t| ≤ c := by
  rcases le_or_gt |t| c with h1 | h1
  · exact h1
  · exfalso
    have h2 := mul_self_lt_mul_self hc h1
    rw [abs_mul_abs_self] at h2
    linarith

lemma le_abs_of_sq {t c : ℝ} (hc : 0 ≤ c) (h : c*c ≤ t*t) : c ≤ |t| := by
  rcases le_or_gt c |t| with h1 | h1
  · exact h1
  · exfalso
    have h2 := mul_self_lt_mul_self (abs_nonneg t) h1
    rw [abs_mul_abs_self] at h2
    linarith

/-- **`lam_box`**（核その二）：`|d|²·(4 lam² + 1) = 4` と `|d|²` の区間から
  `lam` の箱を二つ出す。平方根は現れず、検査は `ℤ` の掛け算だけ。 -/
lemma lam_box {lam D : ℝ} {dl dh ll lu : ℤ}
    (hD1 : (dl:ℝ) ≤ (sc:ℝ) * D) (hD2 : (sc:ℝ) * D ≤ (dh:ℝ)) (hdl : 0 < dl)
    (heq : D * (4*lam^2 + 1) = 4)
    (hll : 0 ≤ ll) (hlu : ll ≤ lu)
    (hU : sc*sc*(4*sc - dl) ≤ 4*dl*lu*lu)
    (hL : ll = 0 ∨ 4*dh*ll*ll ≤ sc*sc*(4*sc - dh)) :
    Sem ⟨ll, lu⟩ lam ∨ Sem ⟨-lu, -ll⟩ lam := by
  have hdlR : (0:ℝ) < (dl:ℝ) := by exact_mod_cast hdl
  have hdhR : (0:ℝ) < (dh:ℝ) := lt_of_lt_of_le hdlR (le_trans hD1 hD2)
  have hluR : (0:ℝ) ≤ (lu:ℝ) := by
    have h : (0:ℤ) ≤ lu := le_trans hll hlu
    exact_mod_cast h
  have hllR : (0:ℝ) ≤ (ll:ℝ) := by exact_mod_cast hll
  have hq : (0:ℝ) ≤ 4*lam^2 + 1 := by positivity
  have hsc : (0:ℝ) < (sc:ℝ) := scR_pos
  -- `4 sc = sc·D·(4 lam² + 1)`
  have key : ((sc:ℝ)*D) * (4*lam^2+1) = 4*(sc:ℝ) := by
    rw [show ((sc:ℝ)*D) * (4*lam^2+1) = (sc:ℝ) * (D * (4*lam^2+1)) from by ring, heq]; ring
  -- 上界
  have hup : ((sc:ℝ)*lam) * ((sc:ℝ)*lam) ≤ (lu:ℝ) * (lu:ℝ) := by
    have s1 : (dl:ℝ) * (4*lam^2+1) ≤ 4*(sc:ℝ) := by
      have := mul_le_mul_of_nonneg_right hD1 hq
      linarith [this, key]
    have s2 : (sc:ℝ)*(sc:ℝ)*((dl:ℝ) * (4*lam^2+1)) ≤ (sc:ℝ)*(sc:ℝ)*(4*(sc:ℝ)) :=
      mul_le_mul_of_nonneg_left s1 (by positivity)
    have e : (sc:ℝ)*(sc:ℝ)*((dl:ℝ) * (4*lam^2+1))
        = 4*(dl:ℝ)*(((sc:ℝ)*lam) * ((sc:ℝ)*lam)) + (dl:ℝ)*((sc:ℝ)*(sc:ℝ)) := by ring
    have e4 : (sc:ℝ)*(sc:ℝ)*(4*(sc:ℝ) - (dl:ℝ)) ≤ 4*(dl:ℝ)*((lu:ℝ)*(lu:ℝ)) := by
      have h : ((sc*sc*(4*sc - dl) : ℤ):ℝ) ≤ ((4*dl*lu*lu : ℤ):ℝ) := by exact_mod_cast hU
      push_cast at h; linarith
    have s5 : (4*(dl:ℝ)) * (((sc:ℝ)*lam) * ((sc:ℝ)*lam)) ≤ (4*(dl:ℝ)) * ((lu:ℝ)*(lu:ℝ)) := by
      linarith [s2, e, e4]
    exact le_of_mul_le_mul_left s5 (by linarith)
  -- 下界
  have hlow : (ll:ℝ) * (ll:ℝ) ≤ ((sc:ℝ)*lam) * ((sc:ℝ)*lam) := by
    rcases hL with h0 | hLi
    · have h : (ll:ℝ) = 0 := by rw [h0]; norm_num
      rw [h]
      have := mul_self_nonneg ((sc:ℝ)*lam)
      linarith
    · have s1 : 4*(sc:ℝ) ≤ (dh:ℝ) * (4*lam^2+1) := by
        have := mul_le_mul_of_nonneg_right hD2 hq
        linarith [this, key]
      have s2 : (sc:ℝ)*(sc:ℝ)*(4*(sc:ℝ)) ≤ (sc:ℝ)*(sc:ℝ)*((dh:ℝ) * (4*lam^2+1)) :=
        mul_le_mul_of_nonneg_left s1 (by positivity)
      have e : (sc:ℝ)*(sc:ℝ)*((dh:ℝ) * (4*lam^2+1))
          = 4*(dh:ℝ)*(((sc:ℝ)*lam) * ((sc:ℝ)*lam)) + (dh:ℝ)*((sc:ℝ)*(sc:ℝ)) := by ring
      have e4 : 4*(dh:ℝ)*((ll:ℝ)*(ll:ℝ)) ≤ (sc:ℝ)*(sc:ℝ)*(4*(sc:ℝ) - (dh:ℝ)) := by
        have h : ((4*dh*ll*ll : ℤ):ℝ) ≤ ((sc*sc*(4*sc - dh) : ℤ):ℝ) := by exact_mod_cast hLi
        push_cast at h; linarith
      have s5 : (4*(dh:ℝ)) * ((ll:ℝ)*(ll:ℝ)) ≤ (4*(dh:ℝ)) * (((sc:ℝ)*lam) * ((sc:ℝ)*lam)) := by
        linarith [s2, e, e4]
      exact le_of_mul_le_mul_left s5 (by linarith)
  have hA : |(sc:ℝ)*lam| ≤ (lu:ℝ) := abs_le_of_sq hluR hup
  have hB : (ll:ℝ) ≤ |(sc:ℝ)*lam| := le_abs_of_sq hllR hlow
  rcases le_or_gt 0 ((sc:ℝ)*lam) with hs | hs
  · left
    rw [abs_of_nonneg hs] at hA hB
    exact ⟨hB, hA⟩
  · right
    rw [abs_of_neg hs] at hA hB
    refine ⟨?_, ?_⟩ <;> simp only [Int.cast_neg] <;> linarith

/-- 単位距離の辺があれば座標差は `[-1, 1]` に入る。 -/
lemma coord_le_one {a b : ℝ} (h : a^2 + b^2 = 1) : -1 ≤ a ∧ a ≤ 1 := by
  have h1 : a*a ≤ 1*1 := by
    have := sq_nonneg b
    have e : a^2 = a*a := by ring
    linarith [h, this, e]
  have h2 : |a| ≤ 1 := abs_le_of_sq (by norm_num) h1
  exact abs_le.mp h2

end UnitDistance.Order11

/-!
##   一般部その二：単位距離実現の定義・座標系の正規化・**証明書の検査器**と
  その健全性（`chk_sound`）。

  証明書 `Tr` は分枝の木である：

  * `.split ll lu t⁺ t⁻`   平面（`pl`）の先頭 `(v, a, b)` に従い `v` を `a, b` から三辺測量する。
      `lam` の上下界 `(ll, lu)` は証明書が差し出し、検査器は `ℤ` の掛け算で検める。
      二つの子は `lam ≥ 0` の側と `lam ≤ 0` の側。
  * `.kill u w`            辺 `uw` について `|p_u − p_w|²` の区間が `1` を含まない。
  * `.bisx/.bisy v mid t₁ t₂`  `v` の箱をその軸・位置 `mid` で二分する（自明に健全）。
  * `.free u p t`          辺 `up` から `u` を `p` のまわりの `[-1,1]²` に置く（自由角の扱い）。

  検査器は箱を**自分で計算する**（証明書は木の形と `lam` の上下界だけを運ぶ）。
  sorry 0・native_decide 不使用。
-/

namespace UnitDistance.Order11

/-! ## 4. 単位距離実現 -/

/-- 辺の条件だけ（非辺には何も課さない・単射性も課さない）。 -/
def Edges (E : List (ℕ × ℕ)) (x y : ℕ → ℝ) : Prop :=
  ∀ e ∈ E, (x e.1 - x e.2)^2 + (y e.1 - y e.2)^2 = 1

def emb (n : ℕ) : Fin 11 := ⟨n % 11, Nat.mod_lt _ (by norm_num)⟩

/-- `E` を辺集合とする 11 点グラフの平面単位距離実現：
  辺は距離 1・**非辺は制約なし**・異なる頂点は異なる点。 -/
def Realiz (E : List (ℕ × ℕ)) (p : Fin 11 → ℝ × ℝ) : Prop :=
  (∀ e ∈ E, ((p (emb e.1)).1 - (p (emb e.2)).1)^2
      + ((p (emb e.1)).2 - (p (emb e.2)).2)^2 = 1) ∧ Function.Injective p

lemma realiz_edges {E : List (ℕ × ℕ)} {p : Fin 11 → ℝ × ℝ} (h : Realiz E p) :
    Edges E (fun n => (p (emb n)).1) (fun n => (p (emb n)).2) := h.1

/-- **正規化**：辺 `ab` があれば、回転と平行移動で `a = (0,0)`・`b = (1,0)` にできる。 -/
lemma normalize (E : List (ℕ × ℕ)) (a b : ℕ) (hab : (a, b) ∈ E) (x y : ℕ → ℝ)
    (h : Edges E x y) :
    ∃ X Y : ℕ → ℝ, Edges E X Y ∧ X a = 0 ∧ Y a = 0 ∧ X b = 1 ∧ Y b = 0 := by
  have hnorm : (x b - x a)^2 + (y b - y a)^2 = 1 := by linear_combination h (a, b) hab
  refine ⟨fun n => (x n - x a) * (x b - x a) + (y n - y a) * (y b - y a),
          fun n => -((x n - x a) * (y b - y a)) + (y n - y a) * (x b - x a), ?_, ?_, ?_, ?_, ?_⟩
  · intro e he
    have hh := h e he
    linear_combination ((x b - x a)^2 + (y b - y a)^2) * hh + hnorm
  · ring
  · ring
  · linear_combination hnorm
  · ring

/-! ## 5. 状態と検査器の部品 -/

/-- 状態：頂点に箱を割り当てる部分写像。 -/
abbrev St := ℕ → Option (Ivl × Ivl)

def upd (σ : St) (v : ℕ) (A : Ivl × Ivl) : St := fun n => if n = v then some A else σ n

def Holds (σ : St) (x y : ℕ → ℝ) : Prop :=
  ∀ v A, σ v = some A → Sem A.1 (x v) ∧ Sem A.2 (y v)

lemma holds_none (X Y : ℕ → ℝ) : Holds (fun _ => none) X Y := by
  intro v A hv
  exact absurd hv (by simp)

lemma holds_upd {σ : St} {x y : ℕ → ℝ} {v : ℕ} {A : Ivl × Ivl}
    (h : Holds σ x y) (hA : Sem A.1 (x v) ∧ Sem A.2 (y v)) : Holds (upd σ v A) x y := by
  intro w B hB
  simp only [upd] at hB
  by_cases hw : w = v
  · subst hw
    rw [if_pos rfl] at hB
    obtain rfl := Option.some.inj hB
    exact hA
  · rw [if_neg hw] at hB
    exact h w B hB

def isEdge (E : List (ℕ × ℕ)) (u w : ℕ) : Bool := decide ((u, w) ∈ E) || decide ((w, u) ∈ E)

lemma edge_eq {E : List (ℕ × ℕ)} {x y : ℕ → ℝ} (hE : Edges E x y) {u w : ℕ}
    (h : isEdge E u w = true) : (x u - x w)^2 + (y u - y w)^2 = 1 := by
  simp only [isEdge, Bool.or_eq_true, decide_eq_true_eq] at h
  rcases h with h | h
  · exact hE (u, w) h
  · have hh := hE (w, u) h
    linear_combination hh

/-- 二点の箱から距離² の区間。 -/
def d2I (A B : Ivl × Ivl) : Ivl :=
  addI (mulI (subI A.1 B.1) (subI A.1 B.1)) (mulI (subI A.2 B.2) (subI A.2 B.2))

lemma d2I_sound {A B : Ivl × Ivl} {x1 y1 x2 y2 : ℝ}
    (h1 : Sem A.1 x1) (h2 : Sem A.2 y1) (h3 : Sem B.1 x2) (h4 : Sem B.2 y2) :
    Sem (d2I A B) ((x1 - x2)^2 + (y1 - y2)^2) := by
  have e1 : (x1 - x2)^2 = (x1 - x2) * (x1 - x2) := by ring
  have e2 : (y1 - y2)^2 = (y1 - y2) * (y1 - y2) := by ring
  rw [e1, e2]
  exact addI_sound (mulI_sound (subI_sound h1 h3) (subI_sound h1 h3))
    (mulI_sound (subI_sound h2 h4) (subI_sound h2 h4))

/-- 葉の検査：距離² の区間が `1` を外す。 -/
def killOK (A B : Ivl × Ivl) : Bool :=
  decide ((d2I A B).hi < sc) || decide (sc < (d2I A B).lo)

lemma killOK_false {A B : Ivl × Ivl} {x1 y1 x2 y2 : ℝ}
    (h1 : Sem A.1 x1) (h2 : Sem A.2 y1) (h3 : Sem B.1 x2) (h4 : Sem B.2 y2)
    (he : (x1 - x2)^2 + (y1 - y2)^2 = 1) (hk : killOK A B = true) : False := by
  have hd := d2I_sound h1 h2 h3 h4
  rw [he] at hd
  obtain ⟨hd1, hd2⟩ := hd
  rw [mul_one] at hd1 hd2
  simp only [killOK, Bool.or_eq_true, decide_eq_true_eq] at hk
  rcases hk with hk | hk
  · have hc : ((d2I A B).hi : ℝ) < ((sc:ℤ):ℝ) := by exact_mod_cast hk
    linarith
  · have hc : ((sc:ℤ):ℝ) < ((d2I A B).lo : ℝ) := by exact_mod_cast hk
    linarith

/-! ## 6. 三辺測量の一歩（箱の伝播） -/

/-- 三辺測量の一歩：`(検査が通ったか, lam ≥ 0 側の箱, lam ≤ 0 側の箱)`。 -/
def triStep (ll lu : ℤ) (A B : Ivl × Ivl) : Bool × (Ivl × Ivl) × (Ivl × Ivl) :=
  let Dx := subI B.1 A.1
  let Dy := subI B.2 A.2
  let Ds := addI (mulI Dx Dx) (mulI Dy Dy)
  let ok := decide (0 ≤ ll) && decide (ll ≤ lu) && decide (0 < Ds.lo) &&
      decide (sc*sc*(4*sc - Ds.lo) ≤ 4*Ds.lo*lu*lu) &&
      (decide (ll = 0) || decide (4*Ds.hi*ll*ll ≤ sc*sc*(4*sc - Ds.hi)))
  let Mx := mulI ⟨shalf, shalf⟩ (addI A.1 B.1)
  let My := mulI ⟨shalf, shalf⟩ (addI A.2 B.2)
  (ok,
   (subI Mx (mulI ⟨ll, lu⟩ Dy), addI My (mulI ⟨ll, lu⟩ Dx)),
   (subI Mx (mulI ⟨-lu, -ll⟩ Dy), addI My (mulI ⟨-lu, -ll⟩ Dx)))

/-- 箱の伝播（`lam` の箱 `L` は任意）。 -/
lemma tri_box {L : Ivl} {A B : Ivl × Ivl} {xa ya xb yb lam : ℝ}
    (hA1 : Sem A.1 xa) (hA2 : Sem A.2 ya) (hB1 : Sem B.1 xb) (hB2 : Sem B.2 yb)
    (hlam : Sem L lam) :
    Sem (subI (mulI ⟨shalf, shalf⟩ (addI A.1 B.1)) (mulI L (subI B.2 A.2)))
        ((1/2) * (xa + xb) - lam * (yb - ya)) ∧
      Sem (addI (mulI ⟨shalf, shalf⟩ (addI A.2 B.2)) (mulI L (subI B.1 A.1)))
        ((1/2) * (ya + yb) + lam * (xb - xa)) :=
  ⟨subI_sound (mulI_sound half_sound (addI_sound hA1 hB1))
      (mulI_sound hlam (subI_sound hB2 hA2)),
   addI_sound (mulI_sound half_sound (addI_sound hA2 hB2))
      (mulI_sound hlam (subI_sound hB1 hA1))⟩

/-- **三辺測量の一歩の健全性**（核その三）。 -/
lemma triStep_sound {ll lu : ℤ} {A B : Ivl × Ivl} {xa ya xb yb xv yv : ℝ}
    (hA1 : Sem A.1 xa) (hA2 : Sem A.2 ya) (hB1 : Sem B.1 xb) (hB2 : Sem B.2 yb)
    (h1 : (xv - xa)^2 + (yv - ya)^2 = 1) (h2 : (xv - xb)^2 + (yv - yb)^2 = 1)
    (hok : (triStep ll lu A B).1 = true) :
    (Sem (triStep ll lu A B).2.1.1 xv ∧ Sem (triStep ll lu A B).2.1.2 yv) ∨
      (Sem (triStep ll lu A B).2.2.1 xv ∧ Sem (triStep ll lu A B).2.2.2 yv) := by
  simp only [triStep, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq] at hok ⊢
  obtain ⟨⟨⟨⟨hll, hlu⟩, hdpos⟩, hU⟩, hL⟩ := hok
  have hDx : Sem (subI B.1 A.1) (xb - xa) := subI_sound hB1 hA1
  have hDy : Sem (subI B.2 A.2) (yb - ya) := subI_sound hB2 hA2
  have hDs : Sem (addI (mulI (subI B.1 A.1) (subI B.1 A.1))
      (mulI (subI B.2 A.2) (subI B.2 A.2))) ((xb - xa)^2 + (yb - ya)^2) := by
    have e1 : (xb - xa)^2 = (xb - xa) * (xb - xa) := by ring
    have e2 : (yb - ya)^2 = (yb - ya) * (yb - ya) := by ring
    rw [e1, e2]
    exact addI_sound (mulI_sound hDx hDx) (mulI_sound hDy hDy)
  obtain ⟨hDs1, hDs2⟩ := hDs
  have hdposR : (0:ℝ) < ((addI (mulI (subI B.1 A.1) (subI B.1 A.1))
      (mulI (subI B.2 A.2) (subI B.2 A.2))).lo : ℝ) := by exact_mod_cast hdpos
  have hDpos : (0:ℝ) < (xb - xa)^2 + (yb - ya)^2 := by
    have h5 : (0:ℝ) < (sc:ℝ) * ((xb - xa)^2 + (yb - ya)^2) := lt_of_lt_of_le hdposR hDs1
    rcases le_or_gt ((xb - xa)^2 + (yb - ya)^2) 0 with hc | hc
    · exfalso
      have h6 : (sc:ℝ) * ((xb - xa)^2 + (yb - ya)^2) ≤ (sc:ℝ) * 0 :=
        mul_le_mul_of_nonneg_left hc (le_of_lt scR_pos)
      rw [mul_zero] at h6
      linarith
    · exact hc
  have hDne : (xb - xa)^2 + (yb - ya)^2 ≠ 0 := ne_of_gt hDpos
  have hlin : (xv - (xa + xb)/2) * (xb - xa) + (yv - (ya + yb)/2) * (yb - ya) = 0 := by
    linear_combination (h1 - h2) / 2
  have hnorm : (xv - (xa + xb)/2)^2 + (yv - (ya + yb)/2)^2
      = 1 - ((xb - xa)^2 + (yb - ya)^2)/4 := by
    linear_combination (h1 + h2) / 2
  obtain ⟨lam, hux, huy⟩ := trilat_core hDne hlin
  have hxv : xv = (1/2) * (xa + xb) - lam * (yb - ya) := by linarith [hux]
  have hyv : yv = (1/2) * (ya + yb) + lam * (xb - xa) := by linarith [huy]
  rw [hux, huy] at hnorm
  have heq : ((xb - xa)^2 + (yb - ya)^2) * (4*lam^2 + 1) = 4 := by linear_combination 4 * hnorm
  rcases lam_box hDs1 hDs2 hdpos heq hll hlu hU hL with hlam | hlam
  · left
    rw [hxv, hyv]
    exact tri_box hA1 hA2 hB1 hB2 hlam
  · right
    rw [hxv, hyv]
    exact tri_box hA1 hA2 hB1 hB2 hlam

/-! ## 7. 証明書の木と検査器 -/

inductive Tr where
  | kill (u w : ℕ) : Tr
  | split (ll lu : ℤ) (tp tm : Tr) : Tr
  | bisx (v : ℕ) (mid : ℤ) (t1 t2 : Tr) : Tr
  | bisy (v : ℕ) (mid : ℤ) (t1 t2 : Tr) : Tr
  | free (u p : ℕ) (t : Tr) : Tr

def chk (E : List (ℕ × ℕ)) : Tr → List (ℕ × ℕ × ℕ) → St → Bool
  | .kill u w, _, σ =>
      match σ u, σ w with
      | some A, some B => isEdge E u w && killOK A B
      | _, _ => false
  | .split ll lu tp tm, pl, σ =>
      match pl with
      | [] => false
      | (v, a, b) :: pl' =>
          match σ a, σ b with
          | some A, some B =>
              isEdge E v a && isEdge E v b && (triStep ll lu A B).1 &&
                chk E tp pl' (upd σ v (triStep ll lu A B).2.1) &&
                chk E tm pl' (upd σ v (triStep ll lu A B).2.2)
          | _, _ => false
  | .bisx v mid t1 t2, pl, σ =>
      match σ v with
      | some A =>
          chk E t1 pl (upd σ v (⟨A.1.lo, mid⟩, A.2)) &&
            chk E t2 pl (upd σ v (⟨mid, A.1.hi⟩, A.2))
      | none => false
  | .bisy v mid t1 t2, pl, σ =>
      match σ v with
      | some A =>
          chk E t1 pl (upd σ v (A.1, ⟨A.2.lo, mid⟩)) &&
            chk E t2 pl (upd σ v (A.1, ⟨mid, A.2.hi⟩))
      | none => false
  | .free u p t, pl, σ =>
      match σ p with
      | some A => isEdge E u p && chk E t pl (upd σ u (addI A.1 ⟨-sc, sc⟩, addI A.2 ⟨-sc, sc⟩))
      | none => false

/-- **検査器の健全性**：`chk` が `true` を返せば、その状態を満たす実現は存在しない。 -/
theorem chk_sound (E : List (ℕ × ℕ)) (x y : ℕ → ℝ) (hE : Edges E x y) :
    ∀ (t : Tr) (pl : List (ℕ × ℕ × ℕ)) (σ : St), Holds σ x y → chk E t pl σ = true → False := by
  intro t
  induction t with
  | kill u w =>
      intro pl σ hσ h
      rcases hu : σ u with _ | A
      · simp [chk, hu] at h
      · rcases hw : σ w with _ | B
        · simp [chk, hu, hw] at h
        · simp only [chk, hu, hw, Bool.and_eq_true] at h
          obtain ⟨he, hk⟩ := h
          obtain ⟨hA1, hA2⟩ := hσ u A hu
          obtain ⟨hB1, hB2⟩ := hσ w B hw
          exact killOK_false hA1 hA2 hB1 hB2 (edge_eq hE he) hk
  | split ll lu tp tm ihp ihm =>
      intro pl σ hσ h
      rcases pl with _ | ⟨q, pl'⟩
      · simp [chk] at h
      · obtain ⟨v, a, b⟩ := q
        rcases ha : σ a with _ | A
        · simp [chk, ha] at h
        · rcases hb : σ b with _ | B
          · simp [chk, ha, hb] at h
          · simp only [chk, ha, hb, Bool.and_eq_true] at h
            obtain ⟨⟨⟨⟨he1, he2⟩, hok⟩, hp⟩, hm⟩ := h
            obtain ⟨hA1, hA2⟩ := hσ a A ha
            obtain ⟨hB1, hB2⟩ := hσ b B hb
            rcases triStep_sound hA1 hA2 hB1 hB2 (edge_eq hE he1) (edge_eq hE he2) hok with
              hbox | hbox
            · exact ihp pl' _ (holds_upd hσ hbox) hp
            · exact ihm pl' _ (holds_upd hσ hbox) hm
  | bisx v mid t1 t2 ih1 ih2 =>
      intro pl σ hσ h
      rcases hv : σ v with _ | A
      · simp [chk, hv] at h
      · simp only [chk, hv, Bool.and_eq_true] at h
        obtain ⟨h1, h2⟩ := h
        obtain ⟨hA1, hA2⟩ := hσ v A hv
        rcases le_or_gt ((sc:ℝ) * x v) ((mid:ℤ) : ℝ) with hc | hc
        · refine ih1 pl _ (holds_upd hσ ?_) h1
          exact ⟨⟨hA1.1, hc⟩, hA2⟩
        · refine ih2 pl _ (holds_upd hσ ?_) h2
          exact ⟨⟨hc.le, hA1.2⟩, hA2⟩
  | bisy v mid t1 t2 ih1 ih2 =>
      intro pl σ hσ h
      rcases hv : σ v with _ | A
      · simp [chk, hv] at h
      · simp only [chk, hv, Bool.and_eq_true] at h
        obtain ⟨h1, h2⟩ := h
        obtain ⟨hA1, hA2⟩ := hσ v A hv
        rcases le_or_gt ((sc:ℝ) * y v) ((mid:ℤ) : ℝ) with hc | hc
        · refine ih1 pl _ (holds_upd hσ ?_) h1
          exact ⟨hA1, ⟨hA2.1, hc⟩⟩
        · refine ih2 pl _ (holds_upd hσ ?_) h2
          exact ⟨hA1, ⟨hc.le, hA2.2⟩⟩
  | free u p t ih =>
      intro pl σ hσ h
      rcases hp : σ p with _ | A
      · simp [chk, hp] at h
      · simp only [chk, hp, Bool.and_eq_true] at h
        obtain ⟨he, hr⟩ := h
        obtain ⟨hA1, hA2⟩ := hσ p A hp
        have hed := edge_eq hE he
        obtain ⟨hx1, hx2⟩ := coord_le_one hed
        have hed' : (y u - y p)^2 + (x u - x p)^2 = 1 := by linear_combination hed
        obtain ⟨hy1, hy2⟩ := coord_le_one hed'
        have hdx : Sem ⟨-sc, sc⟩ (x u - x p) := by
          refine ⟨?_, ?_⟩
          · have h7 : (sc:ℝ) * (-1) ≤ (sc:ℝ) * (x u - x p) :=
              mul_le_mul_of_nonneg_left hx1 (le_of_lt scR_pos)
            simp only [Int.cast_neg]
            linarith
          · have h7 : (sc:ℝ) * (x u - x p) ≤ (sc:ℝ) * 1 :=
              mul_le_mul_of_nonneg_left hx2 (le_of_lt scR_pos)
            linarith
        have hdy : Sem ⟨-sc, sc⟩ (y u - y p) := by
          refine ⟨?_, ?_⟩
          · have h7 : (sc:ℝ) * (-1) ≤ (sc:ℝ) * (y u - y p) :=
              mul_le_mul_of_nonneg_left hy1 (le_of_lt scR_pos)
            simp only [Int.cast_neg]
            linarith
          · have h7 : (sc:ℝ) * (y u - y p) ≤ (sc:ℝ) * 1 :=
              mul_le_mul_of_nonneg_left hy2 (le_of_lt scR_pos)
            linarith
        have hbx := addI_sound hA1 hdx
        have hby := addI_sound hA2 hdy
        have ex : x p + (x u - x p) = x u := by ring
        have ey : y p + (y u - y p) = y u := by ring
        rw [ex] at hbx
        rw [ey] at hby
        refine ih pl _ (holds_upd hσ ?_) hr
        exact ⟨hbx, hby⟩

/-! ## 8. 候補ごとの定理を作る道具 -/

/-- 起点：`a = (0,0)`・`b = (1,0)`。 -/
def st0 (a b : ℕ) : St :=
  upd (upd (fun _ => none) a (⟨0, 0⟩, ⟨0, 0⟩)) b (⟨sc, sc⟩, ⟨0, 0⟩)

lemma holds_st0 {a b : ℕ} {X Y : ℕ → ℝ} (h1 : X a = 0) (h2 : Y a = 0) (h3 : X b = 1)
    (h4 : Y b = 0) : Holds (st0 a b) X Y := by
  refine holds_upd (holds_upd (holds_none X Y) ⟨?_, ?_⟩) ⟨?_, ?_⟩
  · show Sem ⟨(0:ℤ), (0:ℤ)⟩ (X a)
    rw [h1]; constructor <;> norm_num [Sem]
  · show Sem ⟨(0:ℤ), (0:ℤ)⟩ (Y a)
    rw [h2]; constructor <;> norm_num [Sem]
  · show Sem ⟨sc, sc⟩ (X b)
    rw [h3]; constructor <;> norm_num [Sem]
  · show Sem ⟨(0:ℤ), (0:ℤ)⟩ (Y b)
    rw [h4]; constructor <;> norm_num [Sem]

/-- **候補を閉じる道具**：証明書 `t`・平面 `pl` の検査が通れば辺の条件を満たす座標は無い。 -/
theorem close_edges (E : List (ℕ × ℕ)) (a b : ℕ) (hab : (a, b) ∈ E) (t : Tr)
    (pl : List (ℕ × ℕ × ℕ)) (hchk : chk E t pl (st0 a b) = true) :
    ∀ x y : ℕ → ℝ, ¬ Edges E x y := by
  intro x y h
  obtain ⟨X, Y, hXY, h1, h2, h3, h4⟩ := normalize E a b hab x y h
  exact chk_sound E X Y hXY t pl (st0 a b) (holds_st0 h1 h2 h3 h4) hchk

/-- 実現の非存在（`Realiz` の版）。 -/
theorem close_realiz (E : List (ℕ × ℕ)) (a b : ℕ) (hab : (a, b) ∈ E) (t : Tr)
    (pl : List (ℕ × ℕ × ℕ)) (hchk : chk E t pl (st0 a b) = true) :
    ∀ p : Fin 11 → ℝ × ℝ, ¬ Realiz E p := by
  intro p hp
  exact close_edges E a b hab t pl hchk _ _ (realiz_edges hp)


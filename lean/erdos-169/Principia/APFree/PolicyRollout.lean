  ]

theorem blocks_length : blocks793.length = 100 := by decide

theorem blocks793_ok : blocks793.all APFree.StepsMaxElement.stepOK = true := by decide

/-- **110 段すべてで、t_i は B(p_i, q_i, r_i) の最大元である**（2 段先読み政策）。 -/
theorem all_blocks_maxelt :
    ∀ s ∈ blocks793, IsGreatest (APFree.StepsMaxElement.Blk s.1 s.2.1 s.2.2.1) s.2.2.2.1 := by
  intro s hs
  exact APFree.StepsMaxElement.maxelt_of_stepOK s (List.all_eq_true.mp blocks793_ok s hs)

/-- 鎖の t と、ブロックの最大元 t が段ごとに一致する（二つの表が同じ段を指していること）。 -/
theorem chain_matches_blocks :
    (List.zip steps793 blocks793).all (fun x => decide (x.1.2.1 = (x.2.2.2.2.1 : ℤ))) = true := by
  decide

/-! ## 4. M = 3 の段（27 段） -/

/-- ロールアウト政策は M = 3 を **27 段**で使う（率基準は 0 段、深さ 2 の先読みは 1 段、
    深さ 3 は 3 段だった）。APFreeWindowSeparationM3 の `sep_M3` が無ければ、この政策は Lean に入らない。 -/
def m3steps : List (ℤ × ℤ × ℕ) := steps793.filter (fun s => s.2.2 == 3)

theorem m3steps_length : m3steps.length = 27 := by decide

theorem m3_all_separated : ∀ s ∈ m3steps, Separated (APFree.WindowSeparationM3.W3 s.1 s.2.1) := by
  intro s hs
  have hmem : s ∈ steps793 := List.mem_of_mem_filter hs
  have h3 : s.2.2 = 3 := by
    have := List.of_mem_filter hs
    simpa using this
  exact (step_separated s.1 s.2.1 s.2.2 (steps_ok s hmem)).2.2 h3

end APFree.PolicyRollout


  **唯一残っていた未検査前提**を機械検査する。

  【何が未検査だったか】
    APFreeWindowSeparation（定理W）・APFreeNonAveraging（Lemma 1）・APFreeStepsSeparated（110 段への (W) の適用）は
    すべて sorry 0 で通っている。E169-RECORD-NOTE.md §6-2 が挙げる残りの一点は

        「各段の t_i が実際に B(p_i, q_i, r_i) の最大元（maxelt）であること」

    であった。Python の二実装（貪欲な桁決定・count_le の二分探索）が全 110 段で
    一致し、段 1・2 は Lean の全列挙でも一致していたが、110 段全部については
    機械検査ではなかった。本ファイルはそれを Lean に移す。

  【鍵になった観察（APFreeStepsMaxElement）】
    最大性を機械検査するには、素朴には「重み和 r を j 桁で作れるか」という
    到達可能集合の桁 DP が要る（B(14,43,342) では 43×343×14 の表）。
    ところが実データを見ると、**その DP は一切要らない**。
    t の桁ベクトル (k_q, …, k_1)（上位から）を証明書として与えると、
    各位置 j（下に残る桁数を n_j、その位置での残予算を r_j とする）で

        k_j < d < p なるすべての桁 d について
          (N1) T_p(d) > r_j （残予算より重い） または
          (N2) r_j − T_p(d) > n_j · Tmax （残り桁で使い切れない）

    が成り立てば、それだけで t が最大元であることが従う。
    実測（外の生成器）では **110 段・全位置・全桁で (N1) だけが成立**しており、
    (N2) は一度も使われない。「大きい桁は重すぎて予算に入らない」——それだけが
    最大性の理由であった。

  【本ファイルで機械検査したもの】
    (1) T の定義が論文の T_p(k) = (k − ⌊(p+1)/2⌋)(k − ⌊(p−1)/2⌋)/2 と一致する
        （割り算の規約に依存しない形 2·T = (k−a)(k−b) で述べる）
    (2) Blk p q r が論文の B(p,q,r) の定義そのもの（桁を下位から並べた
        Σ_{i=1}^{q} k_i (2p−1)^{i−1} の形とも一致することを mem_Blk_iff で示す）
    (3) le_of_certB : 証明書 (N1)/(N2) が成り立てば、B の任意の元は t 以下
    (4) maxelt_of_stepOK : 一段ぶんの機械検査から IsGreatest (Blk p q r) t
    (5) steps : 110 段の (p, q, r, t, 桁ベクトル) の実データ（t は最大 62 桁）
    (6) **all_steps_maxelt : 110 段すべてで t_i = max B(p_i,q_i,r_i)**

  sorry 0、native_decide 不使用。
-/
import Mathlib.Tactic

namespace APFree.StepsMaxElement

set_option maxRecDepth 100000

/-! ## 1. 重み T_p と、論文の定義との一致 -/

/-- ⌊(p−1)/2⌋ -/
def bb (p : ℕ) : ℕ := (p - 1) / 2

/-- ⌊(p+1)/2⌋ -/
def aa (p : ℕ) : ℕ := (p + 1) / 2

/-- 重み T_p(k) = (k − ⌊(p+1)/2⌋)(k − ⌊(p−1)/2⌋)/2 を自然数として書いたもの。
    ⌊(p+1)/2⌋ = ⌊(p−1)/2⌋ + 1（p ≥ 1）なので積は連続 2 整数の積であり、
    非負かつ偶数である。 -/
def T (p k : ℕ) : ℕ :=
  if bb p < k then (k - bb p - 1) * (k - bb p) / 2
  else (bb p - k) * (bb p + 1 - k) / 2

theorem aa_eq (p : ℕ) (hp : 1 ≤ p) : aa p = bb p + 1 := by
  unfold aa bb; omega

/-- **定義の一致**：割り算の規約に依存しない形で述べる。
    2·T_p(k) = (k − ⌊(p+1)/2⌋)(k − ⌊(p−1)/2⌋)（整数として）。 -/
theorem two_mul_T (p k : ℕ) (hp : 1 ≤ p) :
    2 * (T p k : ℤ) = ((k : ℤ) - (aa p : ℕ)) * ((k : ℤ) - (bb p : ℕ)) := by
  have ha : aa p = bb p + 1 := aa_eq p hp
  rw [ha]
  unfold T
  split
  · rename_i h
    obtain ⟨u, hu⟩ : ∃ u, k - bb p = u + 1 := ⟨k - bb p - 1, by omega⟩
    have h2 : 2 ∣ u * (u + 1) := (Nat.even_mul_succ_self u).two_dvd
    have hnat : 2 * (u * (u + 1) / 2) = u * (u + 1) := Nat.mul_div_cancel' h2
    have hdiv : (k - bb p - 1) * (k - bb p) = u * (u + 1) := by rw [hu]; simp
    have hk : (k : ℤ) = (bb p : ℤ) + 1 + (u : ℤ) := by omega
    have hRHS : ((k : ℤ) - ((bb p + 1 : ℕ) : ℤ)) * ((k : ℤ) - ((bb p : ℕ) : ℤ))
        = ((u * (u + 1) : ℕ) : ℤ) := by push_cast; rw [hk]; ring
    rw [hdiv, hRHS]
    exact_mod_cast hnat
  · rename_i h
    obtain ⟨v, hv⟩ : ∃ v, bb p + 1 - k = v + 1 := ⟨bb p - k, by omega⟩
    have h2 : 2 ∣ v * (v + 1) := (Nat.even_mul_succ_self v).two_dvd
    have hnat : 2 * (v * (v + 1) / 2) = v * (v + 1) := Nat.mul_div_cancel' h2
    have hdiv : (bb p - k) * (bb p + 1 - k) = v * (v + 1) := by
      rw [hv]; congr 1; omega
    have hk : (k : ℤ) = (bb p : ℤ) - (v : ℤ) := by omega
    have hRHS : ((k : ℤ) - ((bb p + 1 : ℕ) : ℤ)) * ((k : ℤ) - ((bb p : ℕ) : ℤ))
        = ((v * (v + 1) : ℕ) : ℤ) := by push_cast; rw [hk]; ring
    rw [hdiv, hRHS]
    exact_mod_cast hnat

/-! ## 2. ブロック B(p,q,r) -/

/-- 桁を**上位から**並べたリストの値。 -/
def valM (base : ℕ) : List ℕ → ℕ
  | [] => 0
  | k :: ks => k * base ^ ks.length + valM base ks

/-- 桁を**下位から**並べたリストの値（論文の Σ_{i=1}^q k_i (2p−1)^{i−1} の順）。 -/
def valL (base : ℕ) : List ℕ → ℕ
  | [] => 0
  | k :: ks => k + base * valL base ks

/-- **B(p,q,r)**（Wróblewski 1984 の定義）：
    底 2p−1 の q 桁の数のうち、各桁が p 未満で、重み T_p の総和が r であるもの全体。 -/
def Blk (p q r : ℕ) : Set ℕ :=
  { s | ∃ ks : List ℕ, ks.length = q ∧ (∀ k ∈ ks, k < p) ∧ (ks.map (T p)).sum = r ∧
        s = valM (2 * p - 1) ks }

theorem valL_append_single (base : ℕ) (ks : List ℕ) (k : ℕ) :
    valL base (ks ++ [k]) = valL base ks + base ^ ks.length * k := by
  induction ks with
  | nil => simp [valL]
  | cons a as ih => simp [valL, ih]; ring

theorem valL_reverse (base : ℕ) (ks : List ℕ) : valL base ks.reverse = valM base ks := by
  induction ks with
  | nil => simp [valL, valM]
  | cons a as ih =>
      simp only [List.reverse_cons, valL_append_single, ih, valM, List.length_reverse]
      ring

/-- 論文の書き方（桁を下位から並べる）でも同じ集合である。 -/
theorem mem_Blk_iff (p q r s : ℕ) :
    s ∈ Blk p q r ↔ ∃ ks : List ℕ, ks.length = q ∧ (∀ k ∈ ks, k < p) ∧
      (ks.map (T p)).sum = r ∧ s = valL (2 * p - 1) ks := by
  constructor
  · rintro ⟨ks, h1, h2, h3, h4⟩
    refine ⟨ks.reverse, by simpa using h1, ?_, ?_, ?_⟩
    · intro k hk; exact h2 k (List.mem_reverse.mp hk)
    · rw [List.map_reverse, List.sum_reverse]; exact h3
    · rw [valL_reverse]; exact h4
  · rintro ⟨ks, h1, h2, h3, h4⟩
    refine ⟨ks.reverse, by simpa using h1, ?_, ?_, ?_⟩
    · intro k hk; exact h2 k (List.mem_reverse.mp hk)
    · rw [List.map_reverse, List.sum_reverse]; exact h3
    · rw [← valL_reverse, List.reverse_reverse]; exact h4

/-! ## 3. 位取りの基本補題 -/

theorem valM_lt (base : ℕ) : ∀ ks : List ℕ, (∀ k ∈ ks, k < base) →
    valM base ks < base ^ ks.length := by
  intro ks
  induction ks with
  | nil => intro _; simp [valM]
  | cons k ks ih =>
      intro h
      have hk : k < base := h k (by simp)
      have ih' : valM base ks < base ^ ks.length := ih (fun d hd => h d (by simp [hd]))
      simp only [valM, List.length_cons]
      calc k * base ^ ks.length + valM base ks
          < k * base ^ ks.length + base ^ ks.length := by omega
        _ = (k + 1) * base ^ ks.length := by ring
        _ ≤ base * base ^ ks.length := Nat.mul_le_mul hk (le_refl _)
        _ = base ^ (ks.length + 1) := by ring

theorem sum_T_le (p Tm : ℕ) (hTm : ∀ k, k < p → T p k ≤ Tm) :
    ∀ ms : List ℕ, (∀ d ∈ ms, d < p) → (ms.map (T p)).sum ≤ ms.length * Tm := by
  intro ms
  induction ms with
  | nil => intro _; simp
  | cons m ms ih =>
      intro h
      have h1 : T p m ≤ Tm := hTm m (h m (by simp))
      have h2 := ih (fun d hd => h d (by simp [hd]))
      simp only [List.map_cons, List.sum_cons, List.length_cons]
      calc T p m + (ms.map (T p)).sum ≤ Tm + ms.length * Tm := by omega
        _ = (ms.length + 1) * Tm := by ring

/-! ## 4. 最大性の証明書 -/

/-- 証明書（Bool 値・kernel で評価できる）。桁は**上位から**。
    `r` はその位置での残予算。各位置で
      * 桁 k が p 未満で、その重みが残予算に収まり、
      * 残り（下位）にも証明書が続き、
      * k より大きいどの桁 d も (N1) 重すぎる か (N2) 予算が余りすぎる
    を要求する。 -/
def certB (p Tm : ℕ) : List ℕ → ℕ → Bool
  | [], r => decide (r = 0)
  | k :: ks, r =>
      decide (k < p) && decide (T p k ≤ r) && certB p Tm ks (r - T p k) &&
      ((List.range p).all fun d =>
        decide (d ≤ k) || decide (r < T p d) || decide (ks.length * Tm < r - T p d))

theorem certB_digits (p Tm : ℕ) : ∀ (ks : List ℕ) (r : ℕ), certB p Tm ks r = true →
    ∀ k ∈ ks, k < p := by
  intro ks
  induction ks with
  | nil => intro r _ k hk; simp at hk
  | cons a as ih =>
      intro r h k hk
      simp only [certB, Bool.and_eq_true, decide_eq_true_eq] at h
      rcases List.mem_cons.mp hk with rfl | hk'
      · exact h.1.1.1
      · exact ih (r - T p a) h.1.2 k hk'

theorem certB_sum (p Tm : ℕ) : ∀ (ks : List ℕ) (r : ℕ), certB p Tm ks r = true →
    (ks.map (T p)).sum = r := by
  intro ks
  induction ks with
  | nil =>
      intro r h
      simp only [certB, decide_eq_true_eq] at h
      simp [h]
  | cons a as ih =>
      intro r h
      simp only [certB, Bool.and_eq_true, decide_eq_true_eq] at h
      have hle : T p a ≤ r := h.1.1.2
      have := ih (r - T p a) h.1.2
      simp only [List.map_cons, List.sum_cons, this]
      omega

/-- **証明書から最大性が出る**（本ファイルの中心）。 -/
theorem le_of_certB (p Tm : ℕ) (hTm : ∀ k, k < p → T p k ≤ Tm) :
    ∀ (ks : List ℕ) (r : ℕ), certB p Tm ks r = true →
      ∀ ms : List ℕ, ms.length = ks.length → (∀ d ∈ ms, d < p) →
        (ms.map (T p)).sum = r → valM (2 * p - 1) ms ≤ valM (2 * p - 1) ks := by
  intro ks
  induction ks with
  | nil =>
      intro r _ ms hlen _ _
      have : ms = [] := List.eq_nil_of_length_eq_zero (by simpa using hlen)
      subst this; simp
  | cons k ks ih =>
      intro r hc ms hlen0 hdig hsum
      simp only [certB, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range,
        Bool.or_eq_true] at hc
      obtain ⟨⟨⟨hkp, hkr⟩, hrec⟩, hall⟩ := hc
      cases ms with
      | nil => simp at hlen0
      | cons m ms' =>
          have hlen : ms'.length = ks.length := by simpa using hlen0
          have hmp : m < p := hdig m (by simp)
          have hms'p : ∀ d ∈ ms', d < p := fun d hd => hdig d (by simp [hd])
          have hbase : ∀ d ∈ ms', d < 2 * p - 1 := by
            intro d hd; have := hms'p d hd; omega
          simp only [List.map_cons, List.sum_cons] at hsum
          rcases lt_trichotomy m k with hlt | heq | hgt
          · -- m < k : 上位の桁が小さいので、下位を最大に取っても届かない
            have hlow : valM (2 * p - 1) ms' < (2 * p - 1) ^ ms'.length := valM_lt _ ms' hbase
            simp only [valM, hlen]
            apply le_of_lt
            calc m * (2 * p - 1) ^ ks.length + valM (2 * p - 1) ms'
                < m * (2 * p - 1) ^ ks.length + (2 * p - 1) ^ ks.length := by
                  rw [hlen] at hlow; omega
              _ = (m + 1) * (2 * p - 1) ^ ks.length := by ring
              _ ≤ k * (2 * p - 1) ^ ks.length := Nat.mul_le_mul hlt (le_refl _)
              _ ≤ k * (2 * p - 1) ^ ks.length + valM (2 * p - 1) ks := by omega
          · -- m = k : 予算がそのまま引き継がれるので帰納法
            rw [heq] at hsum
            have hs' : (ms'.map (T p)).sum = r - T p k := by omega
            have hle := ih (r - T p k) hrec ms' hlen hms'p hs'
            simp only [valM, hlen, heq]
            omega
          · -- m > k : 証明書が排除する
            exfalso
            rcases hall m hmp with (h1 | h1) | h1
            · omega
            · omega
            · -- 残予算が下位で使い切れない
              have hb := sum_T_le p Tm hTm ms' hms'p
              rw [hlen] at hb
              omega

/-! ## 5. 一段ぶんの機械検査 -/

/-- 一段のデータ (p, q, r, t, 桁ベクトル（上位から）) に対する機械検査。 -/
def stepOK (s : ℕ × ℕ × ℕ × ℕ × List ℕ) : Bool :=
  decide (2 ≤ s.1) &&
  ((List.range s.1).all fun k => decide (T s.1 k ≤ T s.1 0)) &&
  decide (s.2.2.2.2.length = s.2.1) &&
  decide (valM (2 * s.1 - 1) s.2.2.2.2 = s.2.2.2.1) &&
  certB s.1 (T s.1 0) s.2.2.2.2 s.2.2.1

theorem maxelt_of_stepOK (s : ℕ × ℕ × ℕ × ℕ × List ℕ) (h : stepOK s = true) :
    IsGreatest (Blk s.1 s.2.1 s.2.2.1) s.2.2.2.1 := by
  simp only [stepOK, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range] at h
  obtain ⟨⟨⟨⟨_hp, hTm'⟩, hlen⟩, hval⟩, hcert⟩ := h
  have hTm : ∀ k, k < s.1 → T s.1 k ≤ T s.1 0 := by
    intro k hk; simpa using hTm' k hk
  have hdig := certB_digits s.1 (T s.1 0) s.2.2.2.2 s.2.2.1 hcert
  have hsum := certB_sum s.1 (T s.1 0) s.2.2.2.2 s.2.2.1 hcert
  constructor
  · exact ⟨s.2.2.2.2, hlen, hdig, hsum, hval.symm⟩
  · rintro x ⟨ms, hml, hmd, hms, rfl⟩
    rw [← hval]
    exact le_of_certB s.1 (T s.1 0) hTm s.2.2.2.2 s.2.2.1 hcert ms (by omega) hmd hms


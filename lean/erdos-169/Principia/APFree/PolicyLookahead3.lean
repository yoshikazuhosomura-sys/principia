theorem blocks_length : blocks791.length = 110 := by decide

theorem blocks791_ok : blocks791.all APFree.StepsMaxElement.stepOK = true := by decide

/-- **110 段すべてで、t_i は B(p_i, q_i, r_i) の最大元である**（2 段先読み政策）。 -/
theorem all_blocks_maxelt :
    ∀ s ∈ blocks791, IsGreatest (APFree.StepsMaxElement.Blk s.1 s.2.1 s.2.2.1) s.2.2.2.1 := by
  intro s hs
  exact APFree.StepsMaxElement.maxelt_of_stepOK s (List.all_eq_true.mp blocks791_ok s hs)

/-- 鎖の t と、ブロックの最大元 t が段ごとに一致する（二つの表が同じ段を指していること）。 -/
theorem chain_matches_blocks :
    (List.zip steps791 blocks791).all (fun x => decide (x.1.2.1 = (x.2.2.2.2.1 : ℤ))) = true := by
  decide

/-! ## 4. M = 3 の段（段 55・57・66） -/

/-- 深さ 3 の先読み政策は M = 3 を三段で使う（深さ 2 は 1 段だけだった）。 -/
def m3steps : List (ℤ × ℤ × ℕ) := steps791.filter (fun s => s.2.2 == 3)

theorem m3steps_length : m3steps.length = 3 := by decide

theorem m3_all_separated : ∀ s ∈ m3steps, Separated (APFree.WindowSeparationM3.W3 s.1 s.2.1) := by
  intro s hs
  have hmem : s ∈ steps791 := List.mem_of_mem_filter hs
  have h3 : s.2.2 = 3 := by
    have := List.of_mem_filter hs
    simpa using this
  exact (step_separated s.1 s.2.1 s.2.2 (steps_ok s hmem)).2.2 h3

end APFree.PolicyLookahead3


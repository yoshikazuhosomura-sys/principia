  , (4015497633541588645386128398300461979278144003631183846251265, 655010254318810176195585073744972764749766309485309737079602, 2)   -- 段109: B(14,42,334)
  , (9996026030039607819359012017835842252805586935718296903741338, 17685276866607874757281256232538988233314075717517790141436046, 1)   -- 段110: B(14,43,342)
  ]

/-- 段の後の頭の最大元（最後の窓の右端）。 -/
def nextZ (z t : ℤ) (M : ℕ) : ℤ := if M = 1 then max (2*z) (z+t) + 1 + t else 2*z + 3*t + 2

/-- 一段ぶんの前提。M = 1 では追加の数値条件は要らない（`M1_offsets` が一般に成り立つ）。
    M = 2 では 3t < z ただ一つ。 -/
def stepOK (z t : ℤ) (M : ℕ) : Bool :=
  decide (0 ≤ z) && decide (0 ≤ t) && (M == 1 || (M == 2 && decide (3*t < z)))

/-- 鎖の検査：先頭の z が `cur` と一致し、各段の前提が成り立ち、
    次の段の z が平行移動の式どおりであること。 -/
def chainOK : List (ℤ × ℤ × ℕ) → ℤ → Bool
  | [], _ => true
  | (z, t, M) :: rest, cur =>
      decide (cur = z) && stepOK z t M && chainOK rest (nextZ z t M)

/-- **110 段のデータが鎖として整合する**（`decide` による機械検査）。
    先頭の 21523361 は頭 Z0 = S ∩ [1, 21523361] の最大元 (3^16−1)/2+1。 -/
theorem chain_verified : chainOK steps 21523361 = true := by decide

/-- 各段の前提が成り立つ。 -/
theorem steps_ok : ∀ p ∈ steps, stepOK p.1 p.2.1 p.2.2 = true := by
  have h : steps.all (fun p => stepOK p.1 p.2.1 p.2.2) = true := by decide
  simpa [List.all_eq_true] using h

/-! ## 4. 主定理 -/

/-- 前提 `stepOK` から、その段の窓が (W) を満たすことが出る。 -/
theorem step_separated (z t : ℤ) (M : ℕ) (h : stepOK z t M = true) :
    (M = 1 → Separated (W1 z t (max (2*z) (z+t) + 1))) ∧
    (M = 2 → Separated (W2 z t)) := by
  simp only [stepOK, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq,
    beq_iff_eq] at h
  obtain ⟨⟨hz, ht⟩, hM⟩ := h
  refine ⟨fun _ => sep_M1 z t _ hz ht (M1_offsets z t).1 (M1_offsets z t).2, fun h2 => ?_⟩
  rcases hM with h1 | ⟨_, h3⟩
  · exact absurd (h1 ▸ h2) (by decide)
  · exact sep_M2 z t hz ht h3

/-- **本定理**：110 段のすべてで、頭とブロック窓の族は窓分離条件 (W) を満たす。
    すなわち ★91 の構成の各段は、APFreeWindowSeparation の `apfree_iUnion_of_separated`
    を適用できる状態にある。 -/
theorem all_steps_separated : ∀ p ∈ steps,
    (p.2.2 = 1 → Separated (W1 p.1 p.2.1 (max (2*p.1) (p.1 + p.2.1) + 1))) ∧
    (p.2.2 = 2 → Separated (W2 p.1 p.2.1)) :=
  fun p hp => step_separated p.1 p.2.1 p.2.2 (steps_ok p hp)

/-! ## 5. 各段で合併が 3-AP-free になること -/

/-- M = 1 の段：頭とブロックの合併は 3-AP-free。 -/
theorem step_M1_apfree (z t a : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t)
    (h1 : 2*z < a) (h2 : z + t < a) (A : Fin 2 → Set ℤ)
    (hbox : ∀ i, ∀ x ∈ A i, (W1 z t a).l i ≤ x ∧ x ≤ (W1 z t a).r i)
    (hfree : ∀ i, IsThreeAPFree (A i)) : IsThreeAPFree (⋃ i, A i) :=
  apfree_iUnion_of_separated (W1 z t a) A hbox hfree (sep_M1 z t a hz ht h1 h2)

/-- M = 2 の段：頭と二つのブロックの合併は 3-AP-free。 -/
theorem step_M2_apfree (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t) (h3 : 3*t < z)
    (A : Fin 3 → Set ℤ)
    (hbox : ∀ i, ∀ x ∈ A i, (W2 z t).l i ≤ x ∧ x ≤ (W2 z t).r i)
    (hfree : ∀ i, IsThreeAPFree (A i)) : IsThreeAPFree (⋃ i, A i) :=
  apfree_iUnion_of_separated (W2 z t) A hbox hfree (sep_M2 z t hz ht h3)

/-- 段数と、最終の頭の最大元。 -/
theorem steps_length : steps.length = 110 := by decide

/-! ## 6. 入れ子（次の段の箱に収まること） -/

/-- 段を継ぐと頭の最大元は必ず増える（倍加税の帰結）。 -/
theorem nextZ_gt (z t : ℤ) (M : ℕ) (hz : 0 ≤ z) (ht : 0 ≤ t) : z < nextZ z t M := by
  simp only [nextZ]; split <;> omega

/-- M = 1 の段の窓は、すべて次の段の箱 [0, nextZ z t 1] に収まる。
    これが `apfree_nested` の `houter_box` にあたる。 -/
theorem W1_in_box (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t) (i : Fin 2) :
    0 ≤ (W1 z t (max (2*z) (z+t) + 1)).l i ∧
    (W1 z t (max (2*z) (z+t) + 1)).r i ≤ nextZ z t 1 := by
  fin_cases i <;> simp only [W1, nextZ] <;> omega

/-- M = 2 の段の窓は、すべて次の段の箱 [0, nextZ z t 2] に収まる。 -/
theorem W2_in_box (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t) (i : Fin 3) :
    0 ≤ (W2 z t).l i ∧ (W2 z t).r i ≤ nextZ z t 2 := by
  fin_cases i <;> simp only [W2, nextZ] <;> omega

end APFree.StepsSeparated


/-- 84 段すべてが APFreeStepsMaxElement の機械検査を通る。 -/
theorem steps774_ok : steps774.all APFree.StepsMaxElement.stepOK = true := by decide

/-- 段数。 -/
theorem steps774_length : steps774.length = 84 := by decide

/-- **84 段すべてで、表の t_i は B(p_i, q_i, r_i) の最大元である。**
    APFreeStepsMaxElement の `maxelt_of_stepOK`（一般補題）をそのまま適用したもの。
    これで、七訂版が ★91 の 110 段について通していた二つの段依存の命題
    （(W) の全段適用＝APFreeStepsSeparated、maxelt＝APFreeStepsMaxElement）が、
    ベルマン政策 84 段についても機械検査済みになる。 -/
theorem all_steps_maxelt :
    ∀ s ∈ steps774, IsGreatest (APFree.StepsMaxElement.Blk s.1 s.2.1 s.2.2.1) s.2.2.2.1 := by
  intro s hs
  exact APFree.StepsMaxElement.maxelt_of_stepOK s (List.all_eq_true.mp steps774_ok s hs)


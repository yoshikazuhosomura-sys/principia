/-- 段の後の頭の最大元（最後の窓の右端）。 -/
def nextZ (z t : ℤ) (K : ℕ) : ℤ :=
  if K = 1 then max (2*z) (z+t) + 1 + t
  else if K = 2 then 2*z + 3*t + 2
  else 3 * max z t + 5*t + z + 4

/-- 一段ぶんの前提。K = 1 と K = 3 では追加の数値条件は要らない。
    K = 2 では 3t < z ただ一つ。 -/
def stepOK (z t : ℤ) (K : ℕ) : Bool :=
  decide (0 ≤ z) && decide (0 ≤ t) &&
    (K == 1 || K == 3 || (K == 2 && decide (3*t < z)))

/-- 鎖の検査：先頭の z が `cur` と一致し、各段の前提が成り立ち、
    次の段の z が平行移動の式どおりであること。 -/
def chainOK : List (ℤ × ℤ × ℕ) → ℤ → Bool
  | [], _ => true
  | (z, t, K) :: rest, cur =>
      decide (cur = z) && stepOK z t K && chainOK rest (nextZ z t K)

/-- **84 段のデータが鎖として整合する**（`decide` による機械検査）。
    先頭の 21523361 は頭 Z0 の最大元 (3^16−1)/2 + 1。 -/
theorem chain_verified : chainOK steps 21523361 = true := by decide

/-- 各段の前提が成り立つ。 -/
theorem steps_ok : ∀ p ∈ steps, stepOK p.1 p.2.1 p.2.2 = true := by
  have h : steps.all (fun p => stepOK p.1 p.2.1 p.2.2) = true := by decide
  simpa [List.all_eq_true] using h

/-- 段数。 -/
theorem steps_length : steps.length = 84 := by decide

/-- 窓型の内訳：M1 が 37 段、M2 が 18 段、M3 が 29 段。 -/
theorem steps_kinds :
    (steps.filter (fun p => p.2.2 == 1)).length = 37 ∧
    (steps.filter (fun p => p.2.2 == 2)).length = 18 ∧
    (steps.filter (fun p => p.2.2 == 3)).length = 29 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## 5. 主定理 -/

/-- 前提 `stepOK` から、その段の窓が (W) を満たすことが出る。 -/
theorem step_separated (z t : ℤ) (K : ℕ) (h : stepOK z t K = true) :
    (K = 1 → Separated (W1 z t (max (2*z) (z+t) + 1))) ∧
    (K = 2 → Separated (W2 z t)) ∧
    (K = 3 → Separated (W3 z t)) := by
  simp only [stepOK, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq,
    beq_iff_eq] at h
  obtain ⟨⟨hz, ht⟩, hK⟩ := h
  refine ⟨fun _ => sep_M1 z t _ hz ht (M1_offsets z t).1 (M1_offsets z t).2,
          fun hK2 => ?_, fun _ => sep_M3 z t hz ht⟩
  rcases hK with (h1 | h3) | ⟨_, hlt⟩
  · exact absurd hK2 (by omega)
  · exact absurd hK2 (by omega)
  · exact sep_M2 z t hz ht hlt

/-- **本定理**：ベルマン政策 84 段のすべてで、頭とブロック窓の族は
    窓分離条件 (W) を満たす。すなわち が作った集合 A の各段は、
    APFreeWindowSeparation の `apfree_iUnion_of_separated`（定理W）を適用できる状態にある。 -/
theorem all_steps_separated : ∀ p ∈ steps,
    (p.2.2 = 1 → Separated (W1 p.1 p.2.1 (max (2*p.1) (p.1 + p.2.1) + 1))) ∧
    (p.2.2 = 2 → Separated (W2 p.1 p.2.1)) ∧
    (p.2.2 = 3 → Separated (W3 p.1 p.2.1)) :=
  fun p hp => step_separated p.1 p.2.1 p.2.2 (steps_ok p hp)

/-! ## 6. 各段で合併が 3-AP-free になること -/

theorem step_M1_apfree (z t a : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t)
    (h1 : 2*z < a) (h2 : z + t < a) (A : Fin 2 → Set ℤ)
    (hbox : ∀ i, ∀ x ∈ A i, (W1 z t a).l i ≤ x ∧ x ≤ (W1 z t a).r i)
    (hfree : ∀ i, IsThreeAPFree (A i)) : IsThreeAPFree (⋃ i, A i) :=
  apfree_iUnion_of_separated (W1 z t a) A hbox hfree (sep_M1 z t a hz ht h1 h2)

theorem step_M2_apfree (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t) (h3 : 3*t < z)
    (A : Fin 3 → Set ℤ)
    (hbox : ∀ i, ∀ x ∈ A i, (W2 z t).l i ≤ x ∧ x ≤ (W2 z t).r i)
    (hfree : ∀ i, IsThreeAPFree (A i)) : IsThreeAPFree (⋃ i, A i) :=
  apfree_iUnion_of_separated (W2 z t) A hbox hfree (sep_M2 z t hz ht h3)

/-- **M = 3 の段：頭と三つのブロックの合併は 3-AP-free。**
    110 段版（APFreeStepsSeparated）には無かった型である。 -/
theorem step_M3_apfree (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t)
    (A : Fin 4 → Set ℤ)
    (hbox : ∀ i, ∀ x ∈ A i, (W3 z t).l i ≤ x ∧ x ≤ (W3 z t).r i)
    (hfree : ∀ i, IsThreeAPFree (A i)) : IsThreeAPFree (⋃ i, A i) :=
  apfree_iUnion_of_separated (W3 z t) A hbox hfree (sep_M3 z t hz ht)

/-! ## 7. 入れ子（次の段の箱に収まること） -/

theorem nextZ_gt (z t : ℤ) (K : ℕ) (hz : 0 ≤ z) (ht : 0 ≤ t) : z < nextZ z t K := by
  simp only [nextZ]; split <;> [skip; split] <;> omega

theorem W1_in_box (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t) (i : Fin 2) :
    0 ≤ (W1 z t (max (2*z) (z+t) + 1)).l i ∧
    (W1 z t (max (2*z) (z+t) + 1)).r i ≤ nextZ z t 1 := by
  fin_cases i <;> simp only [W1, nextZ] <;> omega

theorem W2_in_box (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t) (i : Fin 3) :
    0 ≤ (W2 z t).l i ∧ (W2 z t).r i ≤ nextZ z t 2 := by
  fin_cases i <;> simp only [W2, nextZ] <;> omega

theorem W3_in_box (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t) (i : Fin 4) :
    0 ≤ (W3 z t).l i ∧ (W3 z t).r i ≤ nextZ z t 3 := by
  fin_cases i <;> simp only [W3, nextZ] <;> omega



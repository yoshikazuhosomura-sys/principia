import Mathlib.Tactic
import Principia.APFree.WindowSeparation
import Principia.APFree.StepsMaxElement

namespace APFree.BellmanPolicy
open APFree.WindowSeparation

set_option maxRecDepth 100000

/-! ## 1. M = 1 の段 -/

/-- 頭 [0, z] と一つのブロック窓 [a, a+t]。 -/
def W1 (z t a : ℤ) : Windows (Fin 2) where
  l := fun i => match i with | 0 => 0 | 1 => a
  r := fun i => match i with | 0 => z | 1 => a + t

/-- **M = 1 の段は (W) を満たす**（前提は倍加税そのもの）。 -/
theorem sep_M1 (z t a : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t)
    (h1 : 2*z < a) (h2 : z + t < a) : Separated (W1 z t a) := by
  intro i j k h
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp only [W1] at h ⊢ <;> first | omega | simp at h

/-- 平行移動量の式 a = max(2z, z+t) + 1 は、上の前提を必ず満たす。 -/
theorem M1_offsets (z t : ℤ) :
    2*z < max (2*z) (z+t) + 1 ∧ z + t < max (2*z) (z+t) + 1 :=
  ⟨Int.lt_add_one_iff.mpr (le_max_left _ _), Int.lt_add_one_iff.mpr (le_max_right _ _)⟩

/-! ## 2. M = 2（内側案）の段 -/

/-- 頭 [0, z] と二つのブロック窓 [2z+1, 2z+1+t], [2z+2t+2, 2z+3t+2]。 -/
def W2 (z t : ℤ) : Windows (Fin 3) where
  l := fun i => match i with | 0 => 0 | 1 => 2*z+1 | 2 => 2*z+2*t+2
  r := fun i => match i with | 0 => z | 1 => 2*z+1+t | 2 => 2*z+3*t+2

/-- **M = 2（内側案）の段は (W) を満たす**。数値条件は 3t < z ただ一つ。 -/
theorem sep_M2 (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t) (h3 : 3*t < z) :
    Separated (W2 z t) := by
  intro i j k h
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp only [W2] at h ⊢ <;> first | omega | simp at h

/-- Python の `offs_M2`（内側案）の式が、上の閉じた式と一致する。 -/
theorem M2_offsets (z t : ℤ) (ht : 0 ≤ t) (h3 : 3*t < z) :
    max (2*z) (z+t) + 1 = 2*z + 1 ∧
    max (2*z) (max (2*z) (z+t) + 1 + 2*t) + 1 = 2*z + 2*t + 2 := by
  constructor <;> omega

/-! ## 3. M = 3 の段（**110 段版に無かった型**） -/

/-- 頭 [0, z] と三つのブロック窓。m := max(z, t) と置いて
    o = [m+z+1, 3m+2t+z+3, 3m+4t+z+4]、各窓の幅は t。 -/
def W3 (z t : ℤ) : Windows (Fin 4) where
  l := fun i => match i with
    | 0 => 0
    | 1 => max z t + z + 1
    | 2 => 3 * max z t + 2*t + z + 3
    | 3 => 3 * max z t + 4*t + z + 4
  r := fun i => match i with
    | 0 => z
    | 1 => max z t + z + 1 + t
    | 2 => 3 * max z t + 3*t + z + 3
    | 3 => 3 * max z t + 5*t + z + 4

/-- **M = 3 の段は (W) を満たす**。**追加の数値条件は要らない**——
    0 ≤ z, 0 ≤ t だけで従う。ここが M = 2（3t < z が要る）との違いである。 -/
theorem sep_M3 (z t : ℤ) (hz : 0 ≤ z) (ht : 0 ≤ t) : Separated (W3 z t) := by
  intro i j k h
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp only [W3] at h ⊢ <;> first | omega | simp at h

/-- **W3 は APFreeWindowSeparation の `wrobWindows` の一般化である**：z = t = u で一致する。
    すなわち M = 3 の平行移動は、Wroblewski の 4 元 Salem–Spencer 配置 {0,1,3,4} を
    「頭の幅 z とブロックの幅 t が違う場合」に伸ばしたものにほかならない。 -/
theorem W3_eq_wrob (u : ℤ) : W3 u u = wrobWindows u := by
  have h : max u u = u := max_self u
  simp only [W3, wrobWindows, Windows.mk.injEq]
  constructor <;> funext i <;> fin_cases i <;> simp [h] <;> ring


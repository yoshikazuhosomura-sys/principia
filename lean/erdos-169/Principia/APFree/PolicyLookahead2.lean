/-- 段の後の頭の最大元。M = 3 は第789 の `nextZ3`（= 3·max(z,t) + 5t + z + 4）。 -/
def nextZ790 (z t : ℤ) (M : ℕ) : ℤ :=
  if M = 1 then max (2*z) (z+t) + 1 + t
  else if M = 2 then 2*z + 3*t + 2
  else 3*(max z t) + 5*t + z + 4

/-- 一段ぶんの前提。M = 1 と M = 3 では追加の数値条件が要らない
    （`APFree.StepsSeparated.M1_offsets` と `APFree.WindowSeparationM3.sep_M3` が一般に成り立つため）。
    M = 2（内側案）だけが 3t < z を要求する。 -/
def stepOK790 (z t : ℤ) (M : ℕ) : Bool :=
  decide (0 ≤ z) && decide (0 ≤ t) &&
    (M == 1 || (M == 2 && decide (3*t < z)) || M == 3)

/-- 鎖の検査。 -/
def chainOK790 : List (ℤ × ℤ × ℕ) → ℤ → Bool
  | [], _ => true
  | (z, t, M) :: rest, cur =>
      decide (cur = z) && stepOK790 z t M && chainOK790 rest (nextZ790 z t M)

/-- **110 段のデータが鎖として整合する**。先頭の 21523361 は頭 Z₀ の最大元 (3^16−1)/2+1。 -/
theorem chain_verified : chainOK790 steps790 21523361 = true := by decide

theorem steps_length : steps790.length = 110 := by decide

theorem steps_ok : ∀ p ∈ steps790, stepOK790 p.1 p.2.1 p.2.2 = true := by
  have h : steps790.all (fun p => stepOK790 p.1 p.2.1 p.2.2) = true := by decide
  simpa [List.all_eq_true] using h

/-! ## 2. 窓分離 (W) -/

/-- 前提 `stepOK790` から、その段の窓が (W) を満たすことが出る。
    M = 1 は APFreeStepsSeparated の `sep_M1`、M = 2 は `sep_M2`、M = 3 は **APFreeWindowSeparationM3 の `sep_M3`**。 -/
theorem step_separated (z t : ℤ) (M : ℕ) (h : stepOK790 z t M = true) :
    (M = 1 → Separated (APFree.StepsSeparated.W1 z t (max (2*z) (z+t) + 1))) ∧
    (M = 2 → Separated (APFree.StepsSeparated.W2 z t)) ∧
    (M = 3 → Separated (APFree.WindowSeparationM3.W3 z t)) := by
  simp only [stepOK790, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq,
    beq_iff_eq] at h
  obtain ⟨⟨hz, ht⟩, hM⟩ := h
  refine ⟨fun _ => APFree.StepsSeparated.sep_M1 z t _ hz ht (APFree.StepsSeparated.M1_offsets z t).1
      (APFree.StepsSeparated.M1_offsets z t).2, ?_, fun _ => APFree.WindowSeparationM3.sep_M3 z t hz ht⟩
  intro h2
  rcases hM with (h1 | h3) | h4
  · subst h1; exact absurd h2 (by decide)

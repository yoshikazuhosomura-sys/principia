/-- No six points in general position carry the witness set of class 6.
The hypotheses name the forced midpoint relation and the 8 witnesses used.
The identity is applied to the similarity image of the configuration and
pulled back with `psi_sim` and `cross_sim`. -/
theorem not_pattern_k6 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hr1x : (p 1).1 = (p 2).1 + (p 4).1 - (p 5).1)
    (hr1y : (p 1).2 = (p 2).2 + (p 4).2 - (p 5).2)
    (hw1 : Psi (p 1) (p 3) (p 0) (p 5) = 0)
    (hw2 : Psi (p 0) (p 5) (p 1) (p 2) = 0)
    (hw3 : Psi (p 0) (p 4) (p 1) (p 3) = 0)
    (hw4 : Psi (p 0) (p 2) (p 1) (p 4) = 0)
    (hw5 : Psi (p 2) (p 3) (p 1) (p 5) = 0)
    (hw6 : Psi (p 0) (p 1) (p 2) (p 3) = 0)
    (hw7 : Psi (p 0) (p 3) (p 2) (p 5) = 0)
    (hw8 : Psi (p 0) (p 5) (p 3) (p 4) = 0)
    : False := by
  obtain ⟨hne, hcol, hcyc⟩ := hgp
  have hnz : ((p 5).1 - (p 0).1) ^ 2 + ((p 5).2 - (p 0).2) ^ 2 ≠ 0 := by
    intro h
    exact hne 0 5 (by decide)
      (eq_of_sqdist_eq_zero (by simp only [sqdist]; linear_combination h))
  have key := psi_identity_k6
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5))
    (show simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1) = simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2) + simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4) - simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) by
      simp only [simx, simy]
      linear_combination ((p 5).1 - (p 0).1) * hr1x + ((p 5).2 - (p 0).2) * hr1y)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1) = simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2) + simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4) - simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) by
      simp only [simx, simy]
      linear_combination ((p 5).1 - (p 0).1) * hr1y - ((p 5).2 - (p 0).2) * hr1x)
    (show simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) = 0 by simp only [simx]; ring)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) = 0 by simp only [simy]; ring)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) = 0 by simp only [simy]; ring)
  simp only [psi_sim, cross_sim, sqdist_sim, hw1, hw2, hw3, hw4, hw5, hw6, hw7, hw8, mul_zero, add_zero] at key
  have hz : cross (p 0) (p 1) (p 2) * cross (p 0) (p 3) (p 5) * cross (p 0) (p 4) (p 5) * sqdist (p 3) (p 5) = 0 := by
    have h4 : (((p 5).1 - (p 0).1) ^ 2 + ((p 5).2 - (p 0).2) ^ 2) ^ 4
        * (cross (p 0) (p 1) (p 2) * cross (p 0) (p 3) (p 5) * cross (p 0) (p 4) (p 5) * sqdist (p 3) (p 5)) = 0 := by
      linear_combination -key
    rcases mul_eq_zero.mp h4 with h | h
    · exact absurd h (pow_ne_zero 4 hnz)
    · exact h
  have hf1 : cross (p 0) (p 1) (p 2) ≠ 0 := fun h => hcol 0 1 2 (by decide) (by decide) h
  have hf2 : cross (p 0) (p 3) (p 5) ≠ 0 := fun h => hcol 0 3 5 (by decide) (by decide) h
  have hf3 : cross (p 0) (p 4) (p 5) ≠ 0 := fun h => hcol 0 4 5 (by decide) (by decide) h
  have hf4 : sqdist (p 3) (p 5) ≠ 0 := fun h => hne 3 5 (by decide) (eq_of_sqdist_eq_zero h)
  exact (mul_ne_zero (mul_ne_zero (mul_ne_zero hf1 hf2) hf3) hf4) hz

/-- The mask of class 6. -/
def maskK6 : Mask := 19101637269863264190496

/-- **Class 6, sharp form.**  No six points in general position support the
mask of class 6 while the cell outside the mask listed here is not a
witness.  That cell is needed only to rule out the orthocentric branch of
the dichotomy `parallelogram_or_orthocentric`. -/
theorem not_supports_free_k6 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hs : Supports p maskK6) (hf : cellPsi p 87 ≠ 0) : False := by
  have c25 : Psi (p 1) (p 3) (p 0) (p 5) = 0 := by
    have h := hs 25 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 25 = ((0, 5), (1, 3)) from by decide)] at h
  have c32 : Psi (p 0) (p 5) (p 1) (p 2) = 0 := by
    have h := hs 32 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 32 = ((1, 2), (0, 5)) from by decide)] at h
  have c37 : Psi (p 0) (p 4) (p 1) (p 3) = 0 := by
    have h := hs 37 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 37 = ((1, 3), (0, 4)) from by decide)] at h
  have c42 : Psi (p 0) (p 2) (p 1) (p 4) = 0 := by
    have h := hs 42 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 42 = ((1, 4), (0, 2)) from by decide)] at h
  have c51 : Psi (p 2) (p 3) (p 1) (p 5) = 0 := by
    have h := hs 51 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 51 = ((1, 5), (2, 3)) from by decide)] at h
  have c54 : Psi (p 0) (p 1) (p 2) (p 3) = 0 := by
    have h := hs 54 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 54 = ((2, 3), (0, 1)) from by decide)] at h
  have c67 : Psi (p 0) (p 3) (p 2) (p 5) = 0 := by
    have h := hs 67 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 67 = ((2, 5), (0, 3)) from by decide)] at h
  have c74 : Psi (p 0) (p 5) (p 3) (p 4) = 0 := by
    have h := hs 74 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 74 = ((3, 4), (0, 5)) from by decide)] at h
  have c52 : Psi (p 2) (p 4) (p 1) (p 5) = 0 := by
    have h := hs 52 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 52 = ((1, 5), (2, 4)) from by decide)] at h
  have c64 : Psi (p 1) (p 5) (p 2) (p 4) = 0 := by
    have h := hs 64 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 64 = ((2, 4), (1, 5)) from by decide)] at h
  have hm := midpoint_of_two_complementary_witnesses (p 2) (p 4) (p 1) (p 5)
    (ne_of_gp hgp (by decide)) (ne_of_gp hgp (by decide))
    (ne_of_gp hgp (by decide)) (ne_of_gp hgp (by decide))
    (ncol_of_gp hgp (by decide) (by decide) (by decide))
    c52 c64
    (fun hh => hf (by
      rw [cellPsi_eq (show cellOf 87 = ((4, 5), (1, 2)) from by decide)]
      exact (psi_eq_zero_swap₁₂ (p 1) (p 2) (p 4) (p 5)).1 hh))
  exact not_pattern_k6 p hgp
    (by linarith [hm.1] : (p 1).1 = (p 2).1 + (p 4).1 - (p 5).1)
    (by linarith [hm.2] : (p 1).2 = (p 2).2 + (p 4).2 - (p 5).2)
    c25 c32 c37 c42 c51 c54 c67 c74

/-- **Class 6.**  No six points in general position carry the mask of class 6. -/
theorem not_carries_k6 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hc : Carries p maskK6) : False :=
  not_supports_free_k6 p hgp (supports_of_carries hc)
    (fun hh => absurd ((hc 87 (by norm_num)).1 hh) (by decide))

theorem maskK6_mem : maskK6 ∈ censusRest := by decide













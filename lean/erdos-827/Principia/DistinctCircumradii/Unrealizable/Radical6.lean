      = cross p₀ p₂ p₃ * cross p₀ p₂ p₃ * cross p₀ p₃ p₅ * sqdist p₄ p₅ := by
  simp only [Psi, qq, cross, sqdist, h0x, h0y, h5y, hr1x, hr1y]
  ring

/-- No six points in general position carry the witness set of class 3.
The hypotheses name the forced midpoint relation and the 8 witnesses used.
The identity is applied to the similarity image of the configuration and
pulled back with `psi_sim` and `cross_sim`. -/
theorem not_pattern_k3 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hr1x : (p 1).1 = (p 2).1 - (p 3).1 + (p 4).1)
    (hr1y : (p 1).2 = (p 2).2 - (p 3).2 + (p 4).2)
    (hw1 : Psi (p 1) (p 5) (p 0) (p 3) = 0)
    (hw2 : Psi (p 2) (p 5) (p 0) (p 4) = 0)
    (hw3 : Psi (p 3) (p 4) (p 0) (p 5) = 0)
    (hw4 : Psi (p 0) (p 5) (p 1) (p 4) = 0)
    (hw5 : Psi (p 0) (p 2) (p 1) (p 5) = 0)
    (hw6 : Psi (p 0) (p 4) (p 2) (p 3) = 0)
    (hw7 : Psi (p 0) (p 3) (p 2) (p 5) = 0)
    (hw8 : Psi (p 0) (p 1) (p 3) (p 4) = 0)
    : False := by
  obtain ⟨hne, hcol, hcyc⟩ := hgp
  have hnz : ((p 5).1 - (p 0).1) ^ 2 + ((p 5).2 - (p 0).2) ^ 2 ≠ 0 := by
    intro h
    exact hne 0 5 (by decide)
      (eq_of_sqdist_eq_zero (by simp only [sqdist]; linear_combination h))
  have key := psi_identity_k3
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5))
    (show simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1) = simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2) - simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3) + simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4) by
      simp only [simx, simy]
      linear_combination ((p 5).1 - (p 0).1) * hr1x + ((p 5).2 - (p 0).2) * hr1y)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1) = simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2) - simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3) + simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4) by
      simp only [simx, simy]
      linear_combination ((p 5).1 - (p 0).1) * hr1y - ((p 5).2 - (p 0).2) * hr1x)
    (show simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) = 0 by simp only [simx]; ring)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) = 0 by simp only [simy]; ring)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) = 0 by simp only [simy]; ring)
  simp only [psi_sim, cross_sim, sqdist_sim, hw1, hw2, hw3, hw4, hw5, hw6, hw7, hw8, mul_zero, add_zero] at key
  have hz : cross (p 0) (p 2) (p 3) * cross (p 0) (p 2) (p 3) * cross (p 0) (p 3) (p 5) * sqdist (p 4) (p 5) = 0 := by
    have h4 : (((p 5).1 - (p 0).1) ^ 2 + ((p 5).2 - (p 0).2) ^ 2) ^ 4
        * (cross (p 0) (p 2) (p 3) * cross (p 0) (p 2) (p 3) * cross (p 0) (p 3) (p 5) * sqdist (p 4) (p 5)) = 0 := by
      linear_combination -key
    rcases mul_eq_zero.mp h4 with h | h
    · exact absurd h (pow_ne_zero 4 hnz)
    · exact h
  have hf1 : cross (p 0) (p 2) (p 3) ≠ 0 := fun h => hcol 0 2 3 (by decide) (by decide) h
  have hf2 : cross (p 0) (p 2) (p 3) ≠ 0 := fun h => hcol 0 2 3 (by decide) (by decide) h
  have hf3 : cross (p 0) (p 3) (p 5) ≠ 0 := fun h => hcol 0 3 5 (by decide) (by decide) h
  have hf4 : sqdist (p 4) (p 5) ≠ 0 := fun h => hne 4 5 (by decide) (eq_of_sqdist_eq_zero h)
  exact (mul_ne_zero (mul_ne_zero (mul_ne_zero hf1 hf2) hf3) hf4) hz

/-- The mask of class 3. -/
def maskK3 : Mask := 4934540371430318555265

/-- **Class 3, sharp form.**  No six points in general position support the
mask of class 3 while the cell outside the mask listed here is not a
witness.  That cell is needed only to rule out the orthocentric branch of
the dichotomy `parallelogram_or_orthocentric`. -/
theorem not_supports_free_k3 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hs : Supports p maskK3) (hf : cellPsi p 75 ≠ 0) : False := by
  have c14 : Psi (p 1) (p 5) (p 0) (p 3) = 0 := by
    have h := hs 14 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 14 = ((0, 3), (1, 5)) from by decide)] at h
  have c22 : Psi (p 2) (p 5) (p 0) (p 4) = 0 := by
    have h := hs 22 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 22 = ((0, 4), (2, 5)) from by decide)] at h
  have c29 : Psi (p 3) (p 4) (p 0) (p 5) = 0 := by
    have h := hs 29 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 29 = ((0, 5), (3, 4)) from by decide)] at h
  have c44 : Psi (p 0) (p 5) (p 1) (p 4) = 0 := by
    have h := hs 44 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 44 = ((1, 4), (0, 5)) from by decide)] at h
  have c48 : Psi (p 0) (p 2) (p 1) (p 5) = 0 := by
    have h := hs 48 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 48 = ((1, 5), (0, 2)) from by decide)] at h
  have c55 : Psi (p 0) (p 4) (p 2) (p 3) = 0 := by
    have h := hs 55 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 55 = ((2, 3), (0, 4)) from by decide)] at h
  have c67 : Psi (p 0) (p 3) (p 2) (p 5) = 0 := by
    have h := hs 67 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 67 = ((2, 5), (0, 3)) from by decide)] at h
  have c72 : Psi (p 0) (p 1) (p 3) (p 4) = 0 := by
    have h := hs 72 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 72 = ((3, 4), (0, 1)) from by decide)] at h
  have c63 : Psi (p 1) (p 3) (p 2) (p 4) = 0 := by
    have h := hs 63 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 63 = ((2, 4), (1, 3)) from by decide)] at h
  have c39 : Psi (p 2) (p 4) (p 1) (p 3) = 0 := by
    have h := hs 39 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 39 = ((1, 3), (2, 4)) from by decide)] at h
  have hm := midpoint_of_two_complementary_witnesses (p 1) (p 3) (p 2) (p 4)
    (ne_of_gp hgp (by decide)) (ne_of_gp hgp (by decide))
    (ne_of_gp hgp (by decide)) (ne_of_gp hgp (by decide))
    (ncol_of_gp hgp (by decide) (by decide) (by decide))
    c63 c39
    (fun hh => hf (by
      rw [cellPsi_eq (show cellOf 75 = ((3, 4), (1, 2)) from by decide)]
      first
      | exact hh
      | (simp only [Psi, qq, cross] at hh ⊢; linear_combination hh)
      | (simp only [Psi, qq, cross] at hh ⊢; linear_combination -hh)))
  exact not_pattern_k3 p hgp
    (by linarith [hm.1] : (p 1).1 = (p 2).1 - (p 3).1 + (p 4).1)
    (by linarith [hm.2] : (p 1).2 = (p 2).2 - (p 3).2 + (p 4).2)
    c14 c22 c29 c44 c48 c55 c67 c72

/-- **Class 3.**  No six points in general position carry the mask of class 3. -/
theorem not_carries_k3 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hc : Carries p maskK3) : False :=
  not_supports_free_k3 p hgp (supports_of_carries hc)
    (fun hh => absurd ((hc 75 (by norm_num)).1 hh) (by decide))

theorem maskK3_mem : maskK3 ∈ censusRest := by decide













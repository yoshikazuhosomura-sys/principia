 * p₁.1 ^ 2 * p₂.2 * p₄.2 + (20295948351 / 349799298224) * p₁.1 ^ 2 * p₂.2 ^ 2 + (254254070207 / 174899649112) * p₁.1 ^ 2 * p₂.1 * p₅.1 - (100642100047 / 87449824556) * p₁.1 ^ 2 * p₂.1 * p₄.1 - (72614077799 / 87449824556) * p₁.1 ^ 2 * p₂.1 ^ 2 + (100928769013 / 174899649112) * p₁.1 ^ 2 * p₁.2 * p₄.2 - (13955392407 / 21862456139) * p₁.1 ^ 2 * p₁.2 * p₂.2 + (1539881803 / 21862456139) * p₁.1 ^ 3 * p₅.1 - (29622790695 / 87449824556) * p₁.1 ^ 3 * p₄.1 + (23463263483 / 87449824556) * p₁.1 ^ 3 * p₂.1)
      * Psi p₀ p₃ p₂ p₅
      = cross p₀ p₁ p₂ * cross p₀ p₂ p₅ * cross p₀ p₃ p₄ * sqdist p₀ p₂ := by
  simp only [Psi, qq, cross, sqdist, h0x, h0y, h5y, hr3x, hr3y]
  ring

/-- No six points in general position carry the witness set of class 13.
The hypotheses name the forced midpoint relation and the 8 witnesses used.
The identity is applied to the similarity image of the configuration and
pulled back with `psi_sim` and `cross_sim`. -/
theorem not_pattern_k13 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hr3x : (p 3).1 = (p 0).1 - (p 4).1 + (p 5).1)
    (hr3y : (p 3).2 = (p 0).2 - (p 4).2 + (p 5).2)
    (hw1 : Psi (p 2) (p 5) (p 0) (p 4) = 0)
    (hw2 : Psi (p 1) (p 3) (p 0) (p 5) = 0)
    (hw3 : Psi (p 2) (p 5) (p 1) (p 3) = 0)
    (hw4 : Psi (p 0) (p 2) (p 1) (p 4) = 0)
    (hw5 : Psi (p 2) (p 4) (p 1) (p 5) = 0)
    (hw6 : Psi (p 1) (p 4) (p 2) (p 3) = 0)
    (hw7 : Psi (p 3) (p 5) (p 2) (p 4) = 0)
    (hw8 : Psi (p 0) (p 3) (p 2) (p 5) = 0)
    : False := by
  obtain ⟨hne, hcol, hcyc⟩ := hgp
  have hnz : ((p 5).1 - (p 0).1) ^ 2 + ((p 5).2 - (p 0).2) ^ 2 ≠ 0 := by
    intro h
    exact hne 0 5 (by decide)
      (eq_of_sqdist_eq_zero (by simp only [sqdist]; linear_combination h))
  have key := psi_identity_k13
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5))
    (show simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3) = simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) - simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4) + simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) by
      simp only [simx, simy]
      linear_combination ((p 5).1 - (p 0).1) * hr3x + ((p 5).2 - (p 0).2) * hr3y)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3) = simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) - simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4) + simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) by
      simp only [simx, simy]
      linear_combination ((p 5).1 - (p 0).1) * hr3y - ((p 5).2 - (p 0).2) * hr3x)
    (show simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) = 0 by simp only [simx]; ring)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) = 0 by simp only [simy]; ring)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) = 0 by simp only [simy]; ring)
  simp only [psi_sim, cross_sim, sqdist_sim, hw1, hw2, hw3, hw4, hw5, hw6, hw7, hw8, mul_zero, add_zero] at key
  have hz : cross (p 0) (p 1) (p 2) * cross (p 0) (p 2) (p 5) * cross (p 0) (p 3) (p 4) * sqdist (p 0) (p 2) = 0 := by
    have h4 : (((p 5).1 - (p 0).1) ^ 2 + ((p 5).2 - (p 0).2) ^ 2) ^ 4
        * (cross (p 0) (p 1) (p 2) * cross (p 0) (p 2) (p 5) * cross (p 0) (p 3) (p 4) * sqdist (p 0) (p 2)) = 0 := by
      linear_combination -key
    rcases mul_eq_zero.mp h4 with h | h
    · exact absurd h (pow_ne_zero 4 hnz)
    · exact h
  have hf1 : cross (p 0) (p 1) (p 2) ≠ 0 := fun h => hcol 0 1 2 (by decide) (by decide) h
  have hf2 : cross (p 0) (p 2) (p 5) ≠ 0 := fun h => hcol 0 2 5 (by decide) (by decide) h
  have hf3 : cross (p 0) (p 3) (p 4) ≠ 0 := fun h => hcol 0 3 4 (by decide) (by decide) h
  have hf4 : sqdist (p 0) (p 2) ≠ 0 := fun h => hne 0 2 (by decide) (eq_of_sqdist_eq_zero h)
  exact (mul_ne_zero (mul_ne_zero (mul_ne_zero hf1 hf2) hf3) hf4) hz

/-- The mask of class 13. -/
def maskK13 : Mask := 99354312205285548130561

/-- **Class 13, sharp form.**  No six points in general position support the
mask of class 13 while the cell outside the mask listed here is not a
witness.  That cell is needed only to rule out the orthocentric branch of
the dichotomy `parallelogram_or_orthocentric`. -/
theorem not_supports_free_k13 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hs : Supports p maskK13) (hf : cellPsi p 86 ≠ 0) : False := by
  have c22 : Psi (p 2) (p 5) (p 0) (p 4) = 0 := by
    have h := hs 22 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 22 = ((0, 4), (2, 5)) from by decide)] at h
  have c25 : Psi (p 1) (p 3) (p 0) (p 5) = 0 := by
    have h := hs 25 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 25 = ((0, 5), (1, 3)) from by decide)] at h
  have c40 : Psi (p 2) (p 5) (p 1) (p 3) = 0 := by
    have h := hs 40 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 40 = ((1, 3), (2, 5)) from by decide)] at h
  have c42 : Psi (p 0) (p 2) (p 1) (p 4) = 0 := by
    have h := hs 42 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 42 = ((1, 4), (0, 2)) from by decide)] at h
  have c52 : Psi (p 2) (p 4) (p 1) (p 5) = 0 := by
    have h := hs 52 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 52 = ((1, 5), (2, 4)) from by decide)] at h
  have c57 : Psi (p 1) (p 4) (p 2) (p 3) = 0 := by
    have h := hs 57 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 57 = ((2, 3), (1, 4)) from by decide)] at h
  have c65 : Psi (p 3) (p 5) (p 2) (p 4) = 0 := by
    have h := hs 65 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 65 = ((2, 4), (3, 5)) from by decide)] at h
  have c67 : Psi (p 0) (p 3) (p 2) (p 5) = 0 := by
    have h := hs 67 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 67 = ((2, 5), (0, 3)) from by decide)] at h
  have c74 : Psi (p 0) (p 5) (p 3) (p 4) = 0 := by
    have h := hs 74 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 74 = ((3, 4), (0, 5)) from by decide)] at h
  have c29 : Psi (p 3) (p 4) (p 0) (p 5) = 0 := by
    have h := hs 29 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 29 = ((0, 5), (3, 4)) from by decide)] at h
  have hm := midpoint_of_two_complementary_witnesses (p 0) (p 5) (p 3) (p 4)
    (ne_of_gp hgp (by decide)) (ne_of_gp hgp (by decide))
    (ne_of_gp hgp (by decide)) (ne_of_gp hgp (by decide))
    (ncol_of_gp hgp (by decide) (by decide) (by decide))
    c74 c29
    (fun hh => hf (by
      rw [cellPsi_eq (show cellOf 86 = ((4, 5), (0, 3)) from by decide)]
      first
      | exact ((psi_eq_zero_swap₃₄ (p 0) (p 3) (p 4) (p 5)).1 hh)
      | (simp only [Psi, qq, cross] at hh ⊢; linear_combination hh)
      | (simp only [Psi, qq, cross] at hh ⊢; linear_combination -hh)))
  exact not_pattern_k13 p hgp
    (by linarith [hm.1] : (p 3).1 = (p 0).1 - (p 4).1 + (p 5).1)
    (by linarith [hm.2] : (p 3).2 = (p 0).2 - (p 4).2 + (p 5).2)
    c22 c25 c40 c42 c52 c57 c65 c67

/-- **Class 13.**  No six points in general position carry the mask of class 13. -/
theorem not_carries_k13 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hc : Carries p maskK13) : False :=
  not_supports_free_k13 p hgp (supports_of_carries hc)
    (fun hh => absurd ((hc 86 (by norm_num)).1 hh) (by decide))

theorem maskK13_mem : maskK13 ∈ censusRest := by decide













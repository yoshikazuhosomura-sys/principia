/-- No six points in general position carry the witness set of class 22.
The hypotheses name the forced midpoint relation and the 9 witnesses used.
The identity is applied to the similarity image of the configuration and
pulled back with `psi_sim` and `cross_sim`. -/
theorem not_pattern_k22 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hr1x : (p 1).1 = (p 0).1 + (p 2).1 - (p 3).1 + (p 4).1 - (p 5).1)
    (hr1y : (p 1).2 = (p 0).2 + (p 2).2 - (p 3).2 + (p 4).2 - (p 5).2)
    (hw1 : Psi (p 0) (p 2) (p 1) (p 4) = 0)
    (hw2 : Psi (p 3) (p 4) (p 1) (p 5) = 0)
    (hw3 : Psi (p 0) (p 4) (p 2) (p 3) = 0)
    (hw4 : Psi (p 3) (p 5) (p 2) (p 4) = 0)
    (hw5 : Psi (p 0) (p 3) (p 2) (p 5) = 0)
    (hw6 : Psi (p 1) (p 4) (p 2) (p 5) = 0)
    (hw7 : Psi (p 0) (p 5) (p 3) (p 4) = 0)
    (hw8 : Psi (p 1) (p 2) (p 3) (p 4) = 0)
    (hw9 : Psi (p 0) (p 1) (p 3) (p 5) = 0)
    : False := by
  obtain ⟨hne, hcol, hcyc⟩ := hgp
  have hnz : ((p 5).1 - (p 0).1) ^ 2 + ((p 5).2 - (p 0).2) ^ 2 ≠ 0 := by
    intro h
    exact hne 0 5 (by decide)
      (eq_of_sqdist_eq_zero (by simp only [sqdist]; linear_combination h))
  have key := psi_identity_k22
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4))
    (simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5), simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5))
    (show simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1) = simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) + simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2) - simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3) + simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4) - simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) by
      simp only [simx, simy]
      linear_combination ((p 5).1 - (p 0).1) * hr1x + ((p 5).2 - (p 0).2) * hr1y)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 1) = simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) + simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 2) - simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 3) + simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 4) - simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) by
      simp only [simx, simy]
      linear_combination ((p 5).1 - (p 0).1) * hr1y - ((p 5).2 - (p 0).2) * hr1x)
    (show simx (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) = 0 by simp only [simx]; ring)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 0) = 0 by simp only [simy]; ring)
    (show simy (p 0) ((p 5).1 - (p 0).1, (p 5).2 - (p 0).2) (p 5) = 0 by simp only [simy]; ring)
  simp only [psi_sim, cross_sim, hw1, hw2, hw3, hw4, hw5, hw6, hw7, hw8, hw9, mul_zero, add_zero] at key
  have hz : cross (p 0) (p 2) (p 3) * cross (p 0) (p 2) (p 4) * cross (p 0) (p 3) (p 5) * cross (p 0) (p 4) (p 5) = 0 := by
    have h4 : (((p 5).1 - (p 0).1) ^ 2 + ((p 5).2 - (p 0).2) ^ 2) ^ 4
        * (cross (p 0) (p 2) (p 3) * cross (p 0) (p 2) (p 4) * cross (p 0) (p 3) (p 5) * cross (p 0) (p 4) (p 5)) = 0 := by
      linear_combination -key
    rcases mul_eq_zero.mp h4 with h | h
    · exact absurd h (pow_ne_zero 4 hnz)
    · exact h
  have hf1 : cross (p 0) (p 2) (p 3) ≠ 0 := fun h => hcol 0 2 3 (by decide) (by decide) h
  have hf2 : cross (p 0) (p 2) (p 4) ≠ 0 := fun h => hcol 0 2 4 (by decide) (by decide) h
  have hf3 : cross (p 0) (p 3) (p 5) ≠ 0 := fun h => hcol 0 3 5 (by decide) (by decide) h
  have hf4 : cross (p 0) (p 4) (p 5) ≠ 0 := fun h => hcol 0 4 5 (by decide) (by decide) h
  exact (mul_ne_zero (mul_ne_zero (mul_ne_zero hf1 hf2) hf3) hf4) hz


/-! ## The mask of class 22 -/

def maskK22 : Mask := 360264956801041643864353

/-- **Class 22.**  No six points in general position support the mask of
class 22.  Unlike the classes whose relation comes from a parallelogram, no
cell outside the mask is needed: every cell used is one of the fifteen cells
of the mask. -/
theorem not_supports_k22 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hs : Supports p maskK22) : False := by
  have c8 : Psi (p 1) (p 5) (p 0) (p 2) = 0 := by
    have h := hs 8 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 8 = ((0, 2), (1, 5)) from by decide)] at h
  have c19 : Psi (p 1) (p 3) (p 0) (p 4) = 0 := by
    have h := hs 19 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 19 = ((0, 4), (1, 3)) from by decide)] at h
  have c40 : Psi (p 2) (p 5) (p 1) (p 3) = 0 := by
    have h := hs 40 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 40 = ((1, 3), (2, 5)) from by decide)] at h
  have c42 : Psi (p 0) (p 2) (p 1) (p 4) = 0 := by
    have h := hs 42 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 42 = ((1, 4), (0, 2)) from by decide)] at h
  have c53 : Psi (p 3) (p 4) (p 1) (p 5) = 0 := by
    have h := hs 53 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 53 = ((1, 5), (3, 4)) from by decide)] at h
  have c55 : Psi (p 0) (p 4) (p 2) (p 3) = 0 := by
    have h := hs 55 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 55 = ((2, 3), (0, 4)) from by decide)] at h
  have c65 : Psi (p 3) (p 5) (p 2) (p 4) = 0 := by
    have h := hs 65 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 65 = ((2, 4), (3, 5)) from by decide)] at h
  have c67 : Psi (p 0) (p 3) (p 2) (p 5) = 0 := by
    have h := hs 67 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 67 = ((2, 5), (0, 3)) from by decide)] at h
  have c70 : Psi (p 1) (p 4) (p 2) (p 5) = 0 := by
    have h := hs 70 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 70 = ((2, 5), (1, 4)) from by decide)] at h
  have c74 : Psi (p 0) (p 5) (p 3) (p 4) = 0 := by
    have h := hs 74 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 74 = ((3, 4), (0, 5)) from by decide)] at h
  have c75 : Psi (p 1) (p 2) (p 3) (p 4) = 0 := by
    have h := hs 75 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 75 = ((3, 4), (1, 2)) from by decide)] at h
  have c78 : Psi (p 0) (p 1) (p 3) (p 5) = 0 := by
    have h := hs 78 (by norm_num) (by decide)
    rwa [cellPsi_eq (show cellOf 78 = ((3, 5), (0, 1)) from by decide)] at h
  obtain ⟨hrx, hry⟩ := relation_k22 p hgp c8 c19 c40 c53 c65 c78
  exact not_pattern_k22 p hgp hrx hry c42 c53 c55 c65 c67 c70 c74 c75 c78

/-- **Class 22.**  No six points in general position carry the mask of
class 22. -/
theorem not_carries_k22 (p : Fin 6 → Pt) (hgp : GeneralPosition p)
    (hc : Carries p maskK22) : False :=
  not_supports_k22 p hgp (supports_of_carries hc)

theorem maskK22_mem : maskK22 ∈ censusRest := by decide
















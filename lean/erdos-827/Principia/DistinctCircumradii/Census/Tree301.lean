theorem all_settles_nil : ∀ x ∈ ([] : List (Mask × Mask)), Settles x.1 x.2 := by
  intro x hx
  exact absurd hx (by simp)

theorem all_settles_cons {a : Mask × Mask} {L : List (Mask × Mask)}
    (h : Settles a.1 a.2) (hL : ∀ x ∈ L, Settles x.1 x.2) :
    ∀ x ∈ a :: L, Settles x.1 x.2 := by
  intro x hx
  rcases List.mem_cons.mp hx with h' | hx
  · subst h'
    exact h
  · exact hL x hx

